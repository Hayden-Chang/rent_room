[Unit]
Description=Xunju mobile viewing assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xunju-ai
Group=xunju-ai
WorkingDirectory=/opt/xunju-assistant/current
ExecStart=/opt/xunju-runtime/node-v24.21.0-linux-x64/bin/node index.mjs
EnvironmentFile=/etc/xunju-assistant.env
Environment=PORT=3188
Environment=XUNJU_DATA_DIR=/var/lib/xunju-assistant/data
Environment=DSH_HOME=/var/lib/xunju-assistant/harness
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
MemoryMax=400M
CPUQuota=80%
TasksMax=64
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xunju-assistant
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
