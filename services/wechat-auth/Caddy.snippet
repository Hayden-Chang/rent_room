# Insert INSIDE the production api.keeline.xyz site, BEFORE the existing @account
# matcher/handle. Keep all other routes and the staging site unchanged.
@rentRoomLogin path /api/rent-room/auth/wechat
handle @rentRoomLogin {
    reverse_proxy rent-room-auth:8080 {
        transport http {
            dial_timeout 3s
            response_header_timeout 12s
        }
    }
}
