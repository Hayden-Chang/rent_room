page{height:100%;background:#f6f7fb;color:#263047;font-family:-apple-system,BlinkMacSystemFont,sans-serif;}
.page{box-sizing:border-box;min-height:100vh;padding:16px;display:flex;flex-direction:column;}
.row{display:flex;gap:12px;}.card{flex:1;background:#fff;border-radius:16px;overflow:hidden;}.cover{height:142px;background:#eff2ff;padding:10px;box-sizing:border-box;}.badge{padding:3px 8px;border-radius:6px;font-size:11px;color:#5264c9;}.body{padding:12px;display:flex;flex-direction:column;gap:10px;}.name{font-size:14px;font-weight:600;}.rent{color:#5264c9;font-size:17px;font-weight:600;}.address{font-size:11px;color:#8d95a3;}.progress{font-size:12px;color:#8d95a3;}.space{flex:1;min-height:50px;display:flex;align-items:center;justify-content:center;font-size:12px;}.bottom{margin-left:50%;}
