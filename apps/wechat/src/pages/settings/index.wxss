.menu{font-family:inherit;font-size:14px;font-weight:500;line-height:1.5}
.account-summary{display:flex;align-items:center;gap:14px;margin-bottom:16px}.account-avatar:not([size=mini]){width:54px;height:54px;min-height:54px;padding:0;flex-shrink:0;border-radius:50%;overflow:hidden;background:#eceeff;display:flex;align-items:center;justify-content:center}.account-avatar image{width:30px;height:30px}.account-avatar .account-avatar-photo{width:54px;height:54px}.account-info{flex:1;min-width:0}.account-name{width:100%;height:30px;line-height:30px;padding:0;border:0;border-radius:0;font-size:20px;font-weight:600;background:transparent;color:#1c2638}.account-name-placeholder{color:#1c2638}.account-status{margin-top:2px;color:#4d56df;font-size:13px}.account-card .menu{border-top:1px solid #e5e9f1;border-bottom:0;padding-bottom:0}.logout-button:not([size=mini]){width:100%;min-height:48px;margin-top:20px;color:#bb4149;background:#fff}

.workplace-entry{gap:16px}.workplace-title{flex-shrink:0}.workplace-value{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:right}
.guest-title{font-size:18px;font-weight:600;margin-bottom:8px}.guest-account .primary{margin:16px 0}.guest-account .muted{font-size:13px}
