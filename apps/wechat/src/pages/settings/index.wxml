<view hidden="{{!accountReady}}">
<view class="page"><view wx:if="{{saveError}}" class="error" bindtap="retry">{{saveError}}{{recoveryBlocked?'':' 点击重试'}}</view>
 <view wx:if="{{recoveryBlocked}}" class="card recovery-card"><button class="menu" bindtap="recover">尝试恢复本机记录<text>›</text></button></view>
 <view class="card account-card"><view wx:if="{{authenticated}}" class="account-summary"><button class="account-avatar" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" aria-label="选择微信头像"><image class="{{profile.avatarUrl?'account-avatar-photo':''}}" src="{{profile.avatarUrl||'/assets/icons/account.svg'}}" mode="aspectFill" aria-hidden="true"/></button><view class="account-info"><input class="account-name" type="nickname" value="{{profile.nickname}}" placeholder="微信昵称" placeholder-class="account-name-placeholder" maxlength="32" bindblur="nicknameChanged" bindnicknamereview="nicknameReviewed" aria-label="微信昵称"/><view class="account-status">已通过微信登录</view></view></view><view wx:else class="guest-account"><view class="guest-title">未登录也可记录看房</view><view class="muted">登录后可购买房源点数或恢复购买记录</view><button id="account-login" class="primary" loading="{{loginBusy}}" disabled="{{loginBusy}}" bindtap="login">微信登录</button><view wx:if="{{loginError}}" class="error">{{loginError}}</view></view><button class="menu" data-page="capacity" bindtap="open">房源点数<text class="muted">{{remaining}} 点 ›</text></button></view>
 <view class="card"><button class="menu workplace-entry" bindtap="workplace"><text class="workplace-title">上班地点</text><text class="muted workplace-value">{{settings.workplace||'未设置'}} ›</text></button><button class="menu" data-page="archive" bindtap="open">删除房源<text class="muted">{{archived}} 套 ›</text></button><button class="menu" data-page="templates" bindtap="open">模板<text>›</text></button><view class="menu guide-setting"><text>小搭</text><switch color="#4D56DF" checked="{{settings.onboarding}}" bindchange="onboarding"/></view></view>
 <view class="section-title">数据与备份</view><view class="card"><button class="menu menu-import" bindtap="importFile">导入房源<text class="muted">›</text></button><button class="menu menu-export" bindtap="export">导出房源<text class="muted">›</text></button></view>
 <view class="card"><button class="menu" bindtap="permissions">微信权限管理<text>›</text></button></view>
 <view class="card"><view class="menu"><text>版本</text><text class="muted">{{version}}</text></view></view>
<button wx:if="{{authenticated}}" id="account-logout" class="logout-button" bindtap="logout">退出登录</button>
</view>
</view>
<view wx:if="{{!accountReady}}" class="auth-wait">正在确认登录状态…</view>
