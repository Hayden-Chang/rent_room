<view hidden="{{!accountReady}}">
<view class="page"><view wx:if="{{saveError}}" class="error" bindtap="retry">{{saveError}}{{recoveryBlocked?'':' 点击重试'}}</view>
 <view wx:if="{{recoveryBlocked}}" class="card recovery-card"><button class="menu" bindtap="recover">尝试恢复本机记录<text>›</text></button></view>
 <view class="card"><view class="account-summary"><view class="account-avatar"><image src="/assets/icons/account.svg" aria-hidden="true"/></view><view><view class="account-name">微信用户</view><view class="account-status">已通过微信登录</view><view class="account-number">账号 {{account.number}}</view></view></view><view class="account-local">已记录 {{count}} 套房源</view><button class="menu" data-page="capacity" bindtap="open">房源容量<text class="muted">{{count}} / {{limit}} 套 ›</text></button><view class="hint">看房记录和照片仅保存在本机，不会自动同步到其他手机。请定期导出完整备份。</view></view>
 <view class="card"><button class="menu workplace-entry" bindtap="workplace"><text class="workplace-title">上班地点</text><text class="muted workplace-value">{{settings.workplace||'未设置'}} ›</text></button><button class="menu" data-page="archive" bindtap="open">归档房源<text class="muted">{{archived}} 套 ›</text></button><view class="menu guide-setting"><text>操作引导</text><switch color="#4D56DF" checked="{{settings.onboarding}}" bindchange="onboarding"/></view></view>
 <view class="section-title">数据与备份</view><view class="card"><button class="menu menu-import" bindtap="importFile">导入房源<text class="muted">›</text></button><button class="menu menu-export" bindtap="export">导出房源<text class="muted">›</text></button></view>
 <view class="card"><button class="menu" bindtap="permissions">微信权限管理<text>›</text></button></view>
 <view class="card"><view class="menu"><text>版本</text><text class="muted">{{version}}</text></view></view>
<button id="account-logout" class="logout-button" bindtap="logout">退出登录</button>
</view>
</view>
<view wx:if="{{!accountReady}}" class="auth-wait">正在确认登录状态…</view>
