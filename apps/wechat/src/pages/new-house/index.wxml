<view wx:if="{{accountReady}}" class="page name-page"><view class="guide-eyebrow">新的一套，新的发现</view><view class="guide-title">给这套房源起个名字</view><xiaoda pose="greet" text="起个好认的名字，之后就方便找到它啦。"/><view class="card"><view class="subtitle">房源名称</view><input class="name-input" maxlength="80" placeholder="例如：阳光花园3栋" value="{{name}}" bindinput="input" confirm-type="done" bindconfirm="create"/></view><view wx:if="{{error}}" class="error">{{error}}</view><button class="primary guide-primary" hover-class="guide-pressed" loading="{{busy}}" disabled="{{busy}}" bindtap="create">创建房源</button></view>
