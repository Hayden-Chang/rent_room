<view wx:if="{{accountReady}}" class="page"><view class="card"><view class="subtitle">房源名称</view><input class="name-input" maxlength="80" placeholder="例如：阳光花园3栋" value="{{name}}" bindinput="input" confirm-type="done" bindconfirm="create"/></view><view wx:if="{{error}}" class="error">{{error}}</view><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="create">创建房源</button></view>
