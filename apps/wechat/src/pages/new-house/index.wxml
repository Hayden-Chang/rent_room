<view wx:if="{{accountReady}}" class="page name-page"><xiaoda pose="greet" text="给这套房源起个名字"/><view class="card"><input class="name-input" aria-label="房源名称" maxlength="80" placeholder="例如：阳光花园3栋" value="{{name}}" bindinput="input" confirm-type="done" bindconfirm="create"/></view><view wx:if="{{error}}" class="error">{{error}}</view><button class="primary guide-primary" hover-class="guide-pressed" loading="{{busy}}" disabled="{{busy}}" bindtap="create">创建房源</button></view>
