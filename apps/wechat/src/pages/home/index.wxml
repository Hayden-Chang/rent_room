<view class="page">
 <view wx:if="{{saveError}}" class="error" bindtap="retry">{{saveError}} 点击重试</view>
 <view wx:if="{{!accountReady||!houses.length}}" class="empty {{homeMessage?'home-welcome':''}}"><view wx:if="{{homeMessage&&!homeThank}}" class="guide-title">把看过的房子记下来</view><xiaoda wx:if="{{homeMessage&&!homeThank}}" text="{{homeMessage}}" pose="greet" layout="hero"/><image wx:else class="empty-icon" src="/assets/icons/empty-art.png"/><button class="primary guide-primary" hover-class="guide-pressed" disabled="{{!accountReady}}" id="new-house" bindtap="add">新建房源</button></view>
 <view wx:if="{{accountReady && houses.length && !longPressHintDismissed}}" class="long-press-hint" id="house-long-press-hint"><view class="long-press-hint-message"><text class="long-press-hint-icon" aria-hidden="true">i</text><text>长按支持更多操作</text></view><button id="dismiss-long-press-hint" class="long-press-hint-dismiss" hover-class="long-press-hint-pressed" catchtap="dismissLongPressHint">我知道了</button></view>
 <view wx:if="{{accountReady}}" class="grid"><view wx:for="{{houses}}" wx:key="id" class="house" data-id="{{item.id}}" bindtap="open" bindlongpress="manage">
  <view class="cover"><image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill"/><view wx:else class="placeholder"><image src="/assets/icons/home-selected.png"/></view><text class="badge status">{{item.decision||'待检查'}}</text></view>
  <view class="house-body"><view class="house-name">{{item.name}}</view><view class="money">{{item.rent==='待填写'?'租金待填写':item.rent+' 元/月'}}</view><view class="muted address">{{item.address||'地址待填写'}} · {{item.area}}m²</view><view wx:if="{{item.stats.issues}}" class="badge danger">{{item.stats.issues}} 个问题</view><view wx:else class="muted">检查 {{item.stats.done}} / {{item.stats.total}}</view></view>
 </view></view>
 <button wx:if="{{accountReady&&houses.length}}" class="add" id="new-house" bindtap="add" aria-label="新建房源"><image src="/assets/icons/plus.png"/></button>
</view>

<view wx:if="{{accountReady && homeMessage && !feedbackOpen && (houses.length || homeThank)}}" class="home-xiaoda {{!homeThank?'home-invite':''}}"><xiaoda text="{{homeMessage}}" pose="{{homeThank?homePose:'pointDownRight'}}" layout="compact" target-pointer="{{!homeThank?'calc(100% - 24px)':''}}" bindtyped="homeTyped"><view wx:if="{{!homeThank}}" slot="actions" class="home-guide-actions"><button class="guide-secondary" catchtap="waitSecondHouse">再等等</button><button class="primary guide-primary" hover-class="guide-pressed" id="add-second-house" catchtap="add">去添加</button></view></xiaoda></view>
<view wx:if="{{feedbackOpen}}" class="feedback-mask"><view class="feedback-sheet"><view class="feedback-heading">说说你的使用感受</view><button class="feedback-close" bindtap="skipFeedback" disabled="{{feedbackBusy}}" aria-label="关闭反馈"><view class="feedback-close-mark"/></button><xiaoda pose="greet" text="{{homeMessage}}"/><scroll-view scroll-y class="feedback-body"><view wx:for="{{feedbackQuestions}}" wx:key="id" class="feedback-question"><view>{{item.title}}</view><radio-group data-key="{{item.id}}" bindchange="feedbackChoice"><label wx:for="{{item.options}}" wx:for-item="option" wx:key="*this" class="feedback-option {{feedbackDraft[item.id]===option?'chosen':''}}"><radio value="{{option}}" checked="{{feedbackDraft[item.id]===option}}" color="#4D56DF"/>{{option}}</label></radio-group></view><view class="feedback-question">你的使用感受或想要的功能</view><textarea value="{{feedbackDraft.message}}" maxlength="2000" placeholder="哪里不好用，或者希望增加什么功能？" bindinput="feedbackText"/></scroll-view><view wx:if="{{feedbackError}}" class="error">{{feedbackError}}</view><view class="feedback-actions"><button class="guide-secondary" disabled="{{feedbackBusy}}" bindtap="skipFeedback">先跳过</button><button class="primary guide-primary grow" hover-class="guide-pressed" loading="{{feedbackBusy}}" disabled="{{feedbackBusy}}" bindtap="submitFeedback">提交反馈</button></view></view></view>
