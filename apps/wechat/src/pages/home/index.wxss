.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 10px}.house{border-radius:16px;overflow:hidden;background:#fff;min-width:0}.cover{height:142px;background:#eceeff;position:relative}.cover image{width:100%;height:100%}.placeholder{height:142px;display:flex;align-items:center;justify-content:center}.placeholder image{width:46px;height:46px;opacity:.45}.status{position:absolute;top:10px;left:10px}.house-body{padding:12px;height:144px}.house-name{font-size:14px;font-weight:600;line-height:20px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.money{margin:8px 0;font-size:17px;line-height:24px}.address{font-size:11px;line-height:16px;margin-bottom:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.add:not([size=mini]){position:fixed;right:16px;bottom:16px;width:52px;height:52px;min-height:52px;padding:14px;background:white;border:1px solid #e5e9f1;border-radius:26px;box-shadow:0 4px 12px #1c26381f;z-index:10}.add image{width:24px;height:24px;display:block}.empty-icon{width:166px;height:152px;margin:0 auto 24px}.empty button{margin:12px auto}.page{padding-bottom:84px}
