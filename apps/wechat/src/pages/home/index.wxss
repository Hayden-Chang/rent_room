.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 10px}.house{border-radius:16px;overflow:hidden;background:#fff;min-width:0}.cover{height:142px;background:#eceeff;position:relative}.cover image{width:100%;height:100%}.placeholder{height:142px;display:flex;align-items:center;justify-content:center}.placeholder image{width:46px;height:46px;opacity:.45}.status{position:absolute;top:10px;left:10px}.house-body{padding:12px;height:144px}.house-name{font-size:14px;font-weight:600;line-height:20px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.money{margin:8px 0;font-size:17px;line-height:24px}.address{font-size:11px;line-height:16px;margin-bottom:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.add:not([size=mini]){position:fixed;right:16px;bottom:16px;width:52px;height:52px;min-height:52px;padding:14px;background:white;border:1px solid #e5e9f1;border-radius:26px;box-shadow:0 4px 12px #1c26381f;z-index:10}.add image{width:24px;height:24px;display:block}.empty-icon{width:166px;height:152px;margin:0 auto 24px}.empty button{margin:12px auto}.page{padding-bottom:84px}

.empty .primary:not([size=mini]){width:100%;margin-top:12px}
.empty .primary[disabled]{opacity:1;background:#4d56df;color:#fff}

.home-welcome{padding:24px 4px 20px;text-align:left}.home-welcome .guide-title{text-align:center;margin-bottom:28px}.home-welcome .guide-primary{margin-top:28px!important}.home-xiaoda{position:fixed;bottom:calc(20px + env(safe-area-inset-bottom));left:16px;right:16px;z-index:11}.home-guide-actions{margin-top:16px;white-space:normal}.home-guide-actions .guide-primary:not([size=mini]){width:100%;min-height:44px;padding:10px 4px;font-size:14px;border-radius:12px;box-shadow:0 3px 0 #3836b3}.feedback-mask{position:fixed;inset:0;background:#1c23496b;z-index:100;display:flex;align-items:flex-end}.feedback-sheet{position:relative;width:100%;box-sizing:border-box;background:#fff;padding:24px 20px calc(20px + env(safe-area-inset-bottom));border-radius:28px 28px 0 0;max-height:92vh;overflow:auto}.feedback-heading{font-size:22px;font-weight:700;color:#30394c;margin:0 32px 20px 0}.feedback-close:not([size=mini]){position:absolute;right:10px;top:14px;background:transparent;display:flex;align-items:center;justify-content:center;width:44px;height:44px;min-height:44px;padding:0;z-index:2}.feedback-close-mark{position:relative;width:16px;height:16px}.feedback-close-mark::before,.feedback-close-mark::after{content:"";position:absolute;left:7px;top:0;width:2px;height:16px;background:#727c90;transform:rotate(45deg)}.feedback-close-mark::after{transform:rotate(-45deg)}.feedback-body{max-height:44vh;margin:8px 0 16px}.feedback-question{margin:16px 0 8px;font-size:15px;font-weight:600;color:#40495d}.feedback-question radio-group{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.feedback-question .feedback-option{display:flex;align-items:center;min-height:44px;border:2px solid #e2e5ec;padding:8px;border-radius:12px;font-size:13px;font-weight:400}.feedback-option.chosen{border-color:#6159e8;background:#f6f5ff;color:#5250dc}.feedback-question radio{transform:scale(.75);margin-right:0}.feedback-body textarea{box-sizing:border-box;width:100%;height:100px;background:#f8f9fc;border:2px solid #e2e5ec;border-radius:14px;padding:12px;font-size:14px}.feedback-actions{display:flex;align-items:center;gap:12px}.feedback-actions .guide-secondary{flex:1}.feedback-actions .guide-primary{flex:2}
