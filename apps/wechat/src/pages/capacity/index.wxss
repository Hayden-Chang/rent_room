page{background:#fff}.capacity-page{padding:24px 20px calc(24px + env(safe-area-inset-bottom));max-width:600px;margin:auto}.capacity-page>.guide-title{text-align:center;margin-bottom:24px}.capacity-page>.guide-eyebrow{text-align:center}.capacity-summary{padding:16px 20px;margin:24px 0 16px;border:2px solid #e2e5ec;border-radius:20px;display:flex;align-items:center;justify-content:space-between}.capacity-summary .subtitle{font-size:16px}.capacity-number{font-size:32px;font-weight:700;color:#5250dc}.capacity-number text{font-size:16px;font-weight:400;color:#667187}.pack-card{padding:20px;border:2px solid #d9d6fb;border-radius:20px;background:#f8f7ff}.pack-card .subtitle{font-size:17px;font-weight:700;line-height:1.6}.pack-card .guide-secondary:not([size=mini]){width:100%;margin-top:12px}.purchase-pack:not([size=mini]){width:100%;margin-top:20px}.restore-purchases:not([size=mini]){width:100%;margin-top:4px;color:#555bc1;font-weight:600}
