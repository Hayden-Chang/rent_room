<view hidden="{{!accountReady}}">
<view class="page capacity-page">
 <view class="card capacity-summary"><view class="subtitle">房源容量</view><view class="capacity-number">{{used}}<text> / {{limit}} 套</text></view></view>
 <view class="card pack-card"><view class="pack-heading"><view class="subtitle">房源包</view><view class="pack-price">¥1.99</view></view><view class="pack-size">增加 10 套房源容量</view><view wx:if="{{!authenticated}}" class="muted">购买或恢复已购容量需微信登录，免费记录可继续使用。</view><button class="primary purchase-pack" loading="{{busy}}" disabled="{{busy}}" bindtap="purchase">{{authenticated?'¥1.99 扩容10个':'微信登录后购买'}}</button></view>
 <view wx:if="{{error}}" class="error">{{error}}</view>
 <button class="link restore-purchases" disabled="{{busy}}" bindtap="restore">{{authenticated?'刷新容量':'微信登录并恢复容量'}}</button>
</view>

</view>
<view wx:if="{{!accountReady}}" class="auth-wait">正在确认登录状态…</view>
