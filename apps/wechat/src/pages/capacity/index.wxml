<view wx:if="{{accountReady}}" class="page capacity-page">
 <view class="guide-eyebrow">和小搭继续看房</view><view class="guide-title">{{thanking?'谢谢你的小饼干！':'给下一套房源留个位置'}}</view>
 <xiaoda layout="hero" wx:if="{{!busy || thanking}}" pose="{{thanking?'success':'expect'}}" text="{{thanking?'谢谢主人，您现在多了 10 套房源额度啦！':'主人，可以投喂我一个小饼干吗？'}}" bindtyped="paidTyped"/>
 <block wx:if="{{!thanking}}"><view class="card capacity-summary"><view class="subtitle">房源额度</view><view class="capacity-number">{{used}}<text> / {{limit}} 套</text></view></view>
 <view class="card pack-card"><view class="subtitle">🍪 1 块小饼干 = 增加 10 套房源额度</view><view wx:if="{{intent.kind==='restore'}}" class="muted">当前没有可用额度，额度足够后就能恢复这套房源啦。</view><view class="capacity-actions"><button class="guide-secondary" disabled="{{busy}}" bindtap="cancel">先等等</button><button class="primary guide-primary purchase-pack" hover-class="guide-pressed" loading="{{busy}}" disabled="{{busy}}" bindtap="purchase">{{authenticated?'¥1.99 购买小饼干':'微信登录后购买'}}</button></view></view>
 <view wx:if="{{error}}" class="error">{{error}}</view><button class="link restore-purchases" disabled="{{busy}}" bindtap="restore">{{authenticated?'刷新容量':'微信登录并恢复容量'}}</button></block>
</view>
