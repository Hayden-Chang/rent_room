.transfer-page{padding-bottom:calc(140px + env(safe-area-inset-bottom))}.file-bar{background:#fff;border-radius:12px;padding:12px 16px;margin-bottom:12px}.choose-file{padding:8px 0}.selection-bar{margin-bottom:12px}.house-select{width:100%;text-align:left;padding:0;background:transparent;align-items:flex-start}.house-select .check{flex-shrink:0;margin-top:4px}.house-title{word-break:break-word}.conflict{border-top:1px solid #e5e9f1;margin-top:12px}.conflict button{border:1px solid #e5e9f1}.conflict .selected{border-color:#4d56df}.transfer-footer{position:fixed;bottom:0;left:0;right:0;background:#fff;padding:12px 16px calc(16px + env(safe-area-inset-bottom));border-top:1px solid #e5e9f1;z-index:20}.transfer-footer .hint{padding-top:0}.transfer-footer .row{align-items:stretch}.transfer-house{padding:16px}
