<view hidden="{{!accountReady}}">
<view class="page"><view class="title">核对后再导入</view><view class="hint break">{{fileName}}</view><view class="card">将新增 {{houses.length}} 套房源。相同名称也作为新房源加入，不覆盖原记录。</view><view wx:for="{{warnings}}" wx:key="*this" class="error">{{item}}</view><view wx:for="{{houses}}" wx:key="id" class="card"><view class="subtitle">{{item.name}}</view><view class="hint">{{item.fields}} 条检查记录 · {{item.media}} 个影像文件</view></view><view class="row"><button class="grow" bindtap="cancel">取消</button><button class="primary grow" loading="{{importing}}" disabled="{{importing}}" bindtap="commit">确认导入</button></view></view>

</view>
<view wx:if="{{!accountReady}}" class="auth-wait">正在确认登录状态…</view>
