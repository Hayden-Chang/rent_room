<view class="page">
 <view wx:if="{{saveError}}" class="error" bindtap="retry">{{saveError}} 点击重试</view>
 <view class="card">
  <view class="row between"><text class="subtitle">上班地址</text><button wx:if="{{address}}" class="link clear-workplace" bindtap="clear">清空地点</button></view>
  <textarea class="workplace-address" aria-label="上班地址" placeholder="手动填写上班地址或地点" value="{{address}}" bindinput="input" maxlength="200" auto-height/>
  <view class="hint">填写后自动保存，也可以在下方搜索或选点。</view>
 </view>
 <view class="card">
  <address-picker address="{{address}}" location="{{location}}" anchor="{{anchor}}" empty-text="搜索地址或点击定位，选择上班位置" bindselect="selectPlace"/>
 </view>
</view>
