<view hidden="{{!accountReady}}">
<view class="page"><block wx:if="{{!comparing}}"><view wx:if="{{houses.length<2}}" class="hint">选择 2 至 3 套房源进行对比</view><view class="grid"><view wx:for="{{houses}}" wx:key="id" class="house selectable {{selected[0]===item.id||selected[1]===item.id||selected[2]===item.id?'chosen':''}}" data-id="{{item.id}}" bindtap="toggle"><view class="cover"><image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill"/><view wx:else class="placeholder"><image src="/assets/icons/home-selected.png"/></view><view class="selection-hit"><view class="selection-check">{{selected[0]===item.id||selected[1]===item.id||selected[2]===item.id?'✓':''}}</view></view></view><view class="house-body"><view class="house-name">{{item.name}}</view><view class="money">{{item.rent==='—'?'租金待填写':item.rent+' 元/月'}}</view><view class="muted">{{item.area}}m² · {{item.decision||'待检查'}}</view></view></view></view><view class="compare-footer"><button class="primary" disabled="{{selected.length<2}}" bindtap="compare">{{selected.length>=2?'对比这 '+selected.length+' 套房源':selected.length===1?'再选 1 套房源':'选择 2–3 套房源对比'}}</button></view></block>
<block wx:else><view class="difference-control row between"><text>隐藏相同属性</text><switch checked="{{differences}}" color="#4D56DF" bindchange="differences"/></view><view class="table"><view class="tr th"><view class="label-cell">属性</view><view wx:for="{{compared}}" wx:key="id" class="cell">{{item.name}}</view></view><view wx:for="{{rows}}" wx:key="id" class="tr {{item.different?'different':''}}"><view class="label-cell">{{item.label}}</view><view wx:for="{{item.values}}" wx:for-item="value" wx:key="index" class="cell {{value==='未填写'?'muted':''}}">{{value}}</view></view></view><view wx:if="{{!rows.length}}" class="empty">所选房源没有已显示的差异</view><view class="compare-footer"><button class="primary" bindtap="back">返回选择房源</button></view></block></view>

</view>
<view wx:if="{{!accountReady}}" class="auth-wait">正在确认登录状态…</view>
