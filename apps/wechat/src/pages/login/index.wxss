.login-page{min-height:calc(100vh - 44px);max-width:520px;margin:auto;padding:32px 24px calc(32px + env(safe-area-inset-bottom));display:flex;flex-direction:column;justify-content:space-between;gap:32px}.login-intro{text-align:center;margin:auto 0}.login-art{width:200px;height:180px;margin:16px auto 24px}.login-title{font-size:26px;line-height:1.45;font-weight:600;color:#1c2638}.login-description{font-size:14px;line-height:1.8;color:#667187;margin-top:12px}.login-actions{width:100%}.login-button:not([size=mini]){width:100%;min-height:48px;padding:13px 20px;font-size:16px;border-radius:12px}.login-note{font-size:12px;color:#667187;text-align:center;margin:16px 0}.login-local{font-size:12px;line-height:1.8;text-align:center;color:#667187;padding-top:16px;border-top:1px solid #e5e9f1}.login-error{font-size:13px}
