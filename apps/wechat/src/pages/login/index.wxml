<view class="login-page">
  <view class="login-intro">
    <image class="login-art" src="/assets/icons/empty-art.png" mode="aspectFit" aria-hidden="true"/>
    <view class="login-title">把看房细节，记清楚</view>
    <view class="login-description">记录房源、检查细节，找到适合自己的家。</view>
  </view>
  <view class="login-actions">
    <view wx:if="{{error}}" class="error login-error" role="alert">{{error}}</view>
    <button id="wechat-login" class="primary login-button" bindtap="login" loading="{{busy}}" disabled="{{busy}}">{{busy?'正在登录':'微信登录'}}</button>
    <view class="login-note">登录仅用于确认账号，无需填写个人资料。</view>
    <view class="login-local"><view>看房记录和照片仅保存在本机。</view><view>换手机或清理数据前，请先导出完整备份。</view></view>
  </view>
</view>
