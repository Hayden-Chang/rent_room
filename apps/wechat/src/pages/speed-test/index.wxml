<view hidden="{{!accountReady}}">
<view class="speed-page">
 <view class="speed-card">
  <text class="speed-title">下载速度</text>
  <view class="speed-value">{{speed}}<text class="speed-unit">Mbps</text></view>
  <progress percent="{{progress}}" stroke-width="6" activeColor="#4D56DF" backgroundColor="#eceeff" border-radius="6"/>
  <view wx:if="{{state!=='testing'&&state!=='preparing'}}" class="speed-message" aria-live="polite">{{message}}</view>
  <view class="speed-actions">
   <button wx:if="{{state==='testing'||state==='preparing'}}" class="speed-button speed-cancel" bindtap="back">取消</button>
   <button wx:elif="{{state==='save-error'}}" class="speed-button speed-retry" bindtap="saveResult">重试保存</button>
   <button wx:elif="{{state!=='done'}}" class="speed-button speed-retry" bindtap="start">重新测速</button>
  </view>
 </view>
</view>

</view>
<view wx:if="{{!accountReady}}" class="auth-wait">正在确认登录状态…</view>
