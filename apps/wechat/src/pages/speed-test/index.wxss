.speed-page{padding:24px 20px}.speed-card{background:#fff;border:1px solid #e5e9f1;border-radius:16px;padding:28px 24px;text-align:center}.speed-title{font-size:15px;color:#667187}.speed-value{font-size:48px;font-weight:600;color:#4d56df;margin:24px 0 28px;word-break:break-all}.speed-unit{font-size:15px;font-weight:400;color:#667187}.speed-message{font-size:15px;line-height:24px;margin-top:22px;color:#1c2638}.speed-traffic{font-size:12px;color:#667187;margin-top:12px}.speed-help{font-size:13px;line-height:22px;color:#667187;margin:18px 4px}.speed-button{font-size:15px;line-height:24px;min-height:48px;padding:12px;margin-top:12px;background:#4d56df;color:#fff;border-radius:10px}.speed-button::after{border:0}.speed-button.secondary{background:#eceeff;color:#4d56df}
