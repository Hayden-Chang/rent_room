.speed-page{padding:24px 16px calc(24px + env(safe-area-inset-bottom))}
.speed-card{background:#fff;border:1px solid #e5e9f1;border-radius:20px;padding:28px 24px 20px;text-align:center}
.speed-title{font-size:15px;color:#667187}
.speed-value{display:flex;justify-content:center;align-items:baseline;gap:6px;font-size:52px;line-height:1.2;font-weight:600;font-variant-numeric:tabular-nums;color:#4d56df;margin:34px 0 38px}
.speed-unit{font-size:15px;font-weight:400;color:#667187}
.speed-message{font-size:14px;line-height:22px;margin-top:24px;color:#667187}
.speed-actions{display:flex;justify-content:center;margin-top:24px}
.speed-button{font-size:15px;line-height:24px;min-height:44px;padding:10px 28px;border-radius:24px}
.speed-button::after{border:0}
.speed-cancel{background:#f5f7fb;color:#667187}
.speed-retry{background:#eceeff;color:#4d56df}
