<view wx:if="{{accountReady}}" class="page welcome {{step==='mode'?'mode-step':''}}">
 <view class="welcome-progress"><view class="steps"><view class="filled"/><view class="{{step==='mode'?'filled':''}}"/></view><text>{{step==='sort'?'1':'2'}} / 2</text></view>
 <view class="guide-title">{{step==='sort'?'定制你的看房清单':'选一种记录方式'}}</view>
 <block wx:if="{{step==='sort'}}"><xiaoda id="welcome-xiaoda" pose="greet" text="{{intro}}" highlights="{{introHighlights}}" highlight-color="#E6AE25" icons="{{introIcons}}"/><view class="sorting-list"><template-editor id="template-editor" config="{{config}}" bindchange="change"/></view><view wx:if="{{error}}" class="error">{{error}}</view><view class="bottom"><button class="primary guide-primary" hover-class="guide-pressed" bindtap="next">排好啦</button></view></block>
 <block wx:else>
  <view class="modes">
   <view class="mode {{mode==='simple'?'selected':''}}" data-mode="simple" bindtap="selectMode">
    <button id="mode-simple" class="mode-choice" data-mode="simple" catchtap="selectMode" aria-role="radio" aria-checked="{{mode==='simple'}}" aria-label="{{mode==='simple'?'已选择精简模式':'选择精简模式'}}" disabled="{{busy}}"><view class="mode-radio {{mode==='simple'?'checked':''}}"/><view class="mode-label"><text>精简模式</text><text class="mode-description">90个检查项，突出重点</text></view></button>
   </view>
   <view class="mode {{mode==='detailed'?'selected':''}}" data-mode="detailed" bindtap="selectMode">
    <button id="mode-detailed" class="mode-choice" data-mode="detailed" catchtap="selectMode" aria-role="radio" aria-checked="{{mode==='detailed'}}" aria-label="{{mode==='detailed'?'已选择详细模式':'选择详细模式'}}" disabled="{{busy}}"><view class="mode-radio {{mode==='detailed'?'checked':''}}"/><view class="mode-label"><text>详细模式</text><text class="mode-description">200+检查项，更加全面</text></view></button>
   </view>
  </view>
  <view class="bottom"><button class="back guide-secondary" bindtap="back">返回调整</button><button class="primary guide-primary grow" hover-class="guide-pressed" bindtap="finish" loading="{{busy}}" disabled="{{busy}}">选好啦</button></view>
 </block>
</view>
