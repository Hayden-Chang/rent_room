<view wx:if="{{accountReady}}" class="page welcome {{step==='mode'?'mode-step':''}}">
 <view class="welcome-progress"><view class="steps"><view class="filled"/><view class="{{step==='mode'?'filled':''}}"/></view><text>{{step==='sort'?'1':'2'}} / 2</text></view>
 <view class="guide-eyebrow">和小搭一起，准备看房</view><view class="guide-title">{{step==='sort'?'定制你的看房清单':'选一种记录方式'}}</view>
 <block wx:if="{{step==='sort'}}"><xiaoda pose="greet" text="{{intro}}"/><view class="sorting-list"><template-editor config="{{config}}" bindchange="change"/></view><view wx:if="{{error}}" class="error">{{error}}</view><view class="bottom"><button class="primary guide-primary" hover-class="guide-pressed" bindtap="next">排好啦</button></view></block>
 <block wx:else><xiaoda pose="think" layout="compact" text="你喜欢哪种记录方式呀？"/>
  <view class="modes">
   <view class="mode {{mode==='simple'?'selected':''}}" data-mode="simple" bindtap="selectMode">
    <button id="mode-simple" class="mode-choice" data-mode="simple" catchtap="selectMode" aria-role="radio" aria-checked="{{mode==='simple'}}" aria-label="{{mode==='simple'?'已选择精简模式':'选择精简模式'}}" disabled="{{busy}}"><view class="mode-radio {{mode==='simple'?'checked':''}}"/><text>精简模式</text></button>
    <view class="mode-description">看说明，统一记录</view>
    <image class="mode-preview" src="{{examples.simple}}" mode="widthFix" data-mode="simple" catchtap="previewExample" aria-role="button" aria-label="放大精简模式示例"/>
    <view class="mode-summary">具体问题写在备注里</view>

   </view>
   <view class="mode {{mode==='detailed'?'selected':''}}" data-mode="detailed" bindtap="selectMode">
    <button id="mode-detailed" class="mode-choice" data-mode="detailed" catchtap="selectMode" aria-role="radio" aria-checked="{{mode==='detailed'}}" aria-label="{{mode==='detailed'?'已选择详细模式':'选择详细模式'}}" disabled="{{busy}}"><view class="mode-radio {{mode==='detailed'?'checked':''}}"/><text>详细模式</text></button>
    <view class="mode-description">展开子项，逐项记录</view>
    <image class="mode-preview" src="{{examples.detailed}}" mode="widthFix" data-mode="detailed" catchtap="previewExample" aria-role="button" aria-label="放大详细模式示例"/>
    <view class="mode-summary">每个细节单独检查</view>

   </view>
  </view>
  <view class="preview-hint">点击图片可放大查看</view>
  <view class="bottom"><button class="back guide-secondary" bindtap="back">返回调整</button><button class="primary guide-primary grow" hover-class="guide-pressed" bindtap="finish" loading="{{busy}}" disabled="{{busy}}">选好啦</button></view>
 </block>
</view>
