.welcome{padding-bottom:110px}.steps{display:flex;gap:8px;margin:4px 0 22px}.steps view{height:5px;flex:1;border-radius:4px;background:#e4e6f0}.steps .filled{background:#5654ed}.sorting-list{margin-top:24px}.bottom{position:fixed;bottom:0;left:0;right:0;padding:16px 20px calc(16px + env(safe-area-inset-bottom));background:#f5f7fb;display:flex;gap:12px}.bottom .primary{flex:1}.modes{display:flex;gap:12px;margin-top:26px}.mode{width:50%;box-sizing:border-box;background:white;padding:16px 12px;border-radius:18px;border:2px solid transparent;line-height:1.7;font-size:13px}.mode.selected{border-color:#5654ed}.unavailable{color:#8e93a5}.tag{margin-top:8px;font-size:12px;color:#83899c}.example{background:#f6f7fc;padding:12px 8px;margin:18px 0;min-height:150px;border-radius:12px}.example text{display:block;white-space:pre-wrap}.choice{color:#4d56df;margin-top:18px}.back{background:white}
