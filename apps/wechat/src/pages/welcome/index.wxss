.welcome{padding-bottom:110px}.steps{display:flex;gap:8px;margin:4px 0 22px}.steps view{height:5px;flex:1;border-radius:4px;background:#e4e6f0}.steps .filled{background:#5654ed}.sorting-list{margin-top:24px}.bottom{position:fixed;bottom:0;left:0;right:0;padding:16px 20px calc(16px + env(safe-area-inset-bottom));background:#f5f7fb;display:flex;gap:12px}.bottom .primary{flex:1}.modes{display:flex;gap:10px;margin-top:26px}.mode{flex:1;min-width:0;display:flex;flex-direction:column;box-sizing:border-box;background:white;padding:16px 10px 8px;border-radius:18px;border:2px solid transparent;line-height:1.7;font-size:13px}.mode.selected{border-color:#5654ed;color:#1c2638}.example{flex:1;background:#f6f7fc;padding:12px 8px;margin:16px 0;border-radius:12px}.example-title{font-weight:600;margin-bottom:8px}.example text{display:block;white-space:pre-wrap}.example-result{margin-top:12px}.mode-summary{font-size:12px;font-weight:600}.mode-choice:not([size=mini]){width:100%;padding:10px 0;margin:6px 0 0;background:transparent;color:#4d56df;font-size:13px}.mode-check{font-size:20px;vertical-align:middle}.back{background:white}
