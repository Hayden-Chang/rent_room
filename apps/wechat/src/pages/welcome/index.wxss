page{background:#fff}.welcome{padding:20px 20px 124px;max-width:680px;margin:auto}.welcome-progress{display:flex;gap:16px;align-items:center;margin:4px 0 24px;color:#70788b;font-size:12px;font-weight:600}.steps{display:flex;gap:6px;flex:1}.steps view{height:8px;flex:1;border-radius:8px;background:#e9eaf2}.steps .filled{background:#6159e8;box-shadow:inset 0 2px 0 #8982f3}.sorting-list{margin-top:24px}.bottom{position:fixed;bottom:0;left:0;right:0;padding:16px 20px calc(20px + env(safe-area-inset-bottom));background:#fff;display:flex;gap:12px;border-top:1px solid #eceef4;z-index:5}.bottom .primary{flex:1}.modes{display:flex;flex-direction:column;gap:16px;margin-top:24px}.mode{box-sizing:border-box;background:#fff;padding:20px;border-radius:20px;border:2px solid #e2e5ec;font-size:14px}.mode.selected{border-color:#6159e8;background:#f6f5ff;box-shadow:0 3px 0 #d9d6fb}.mode-heading{display:flex;align-items:center;justify-content:space-between;gap:12px}.mode .subtitle{font-size:18px;font-weight:700}.mode-selected{display:flex;align-items:center;gap:6px;flex-shrink:0;color:#5250dc;font-size:12px;font-weight:600}.mode-selected .guide-check{background:#6159e8}.mode-description{font-size:14px;color:#606b7d;margin-top:8px}.unavailable{background:#f8f9fb;color:#747e90}.tag{font-size:12px;color:#70788b;background:#edf0f4;padding:4px 10px;border-radius:8px}.example{background:#fff;padding:14px 16px;margin-top:16px;border-radius:12px;color:#4f596d}.example-title{font-weight:600;margin-bottom:6px}.example-items{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;font-size:13px;line-height:1.6}.back{background:#fff}
