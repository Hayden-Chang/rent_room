page{background:#fff}.welcome{padding:20px 20px 124px;max-width:680px;margin:auto}.welcome-progress{display:flex;gap:16px;align-items:center;margin:4px 0 24px;color:#70788b;font-size:12px;font-weight:600}.steps{display:flex;gap:6px;flex:1}.steps view{height:8px;flex:1;border-radius:8px;background:#e9eaf2}.steps .filled{background:#6159e8;box-shadow:inset 0 2px 0 #8982f3}.sorting-list{margin-top:24px}.bottom{position:fixed;bottom:0;left:0;right:0;padding:16px 20px calc(20px + env(safe-area-inset-bottom));background:#fff;display:flex;gap:12px;border-top:1px solid #eceef4;z-index:5}.bottom .primary{flex:1}.back{background:#fff}
.modes{display:flex;flex-direction:column;gap:16px;margin-top:16px}.mode{min-width:0;box-sizing:border-box;padding:12px 14px;border:2px solid #e2e5ec;border-radius:18px;background:#fff;color:#343b4d}.mode.selected{border-color:#6159e8;background:#f6f5ff;box-shadow:0 3px 0 #d9d6fb}.mode .mode-choice:not([size=mini]){display:flex;align-items:center;justify-content:flex-start;gap:8px;width:100%;min-height:44px;margin:0;padding:8px 0;border-radius:10px;background:transparent;color:#343b4d;font-size:18px;font-weight:700;line-height:1.5}.mode.selected .mode-choice:not([size=mini]){color:#5149cf}.mode-radio{width:20px;height:20px;border:1.5px solid #b5bac8;border-radius:50%;box-sizing:border-box;flex-shrink:0;background:#fff}.mode-radio.checked{border:6px solid #6159e8}.mode-label{display:flex;flex-direction:column;gap:4px;flex:1;min-width:0;text-align:left;white-space:normal}.mode-description{font-size:14px;font-weight:400;line-height:1.5;white-space:normal;color:#606b7d}
.mode-step .welcome-progress{margin-bottom:12px}.mode-step .guide-eyebrow{display:none}.mode-step .guide-title{margin-bottom:0}
@media(max-width:360px){.welcome{padding-left:14px;padding-right:14px}.mode{padding-left:12px;padding-right:12px}}
