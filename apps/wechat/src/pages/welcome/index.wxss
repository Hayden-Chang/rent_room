page{background:#fff}.welcome{padding:20px 20px 124px;max-width:680px;margin:auto}.welcome-progress{display:flex;gap:16px;align-items:center;margin:4px 0 24px;color:#70788b;font-size:12px;font-weight:600}.steps{display:flex;gap:6px;flex:1}.steps view{height:8px;flex:1;border-radius:8px;background:#e9eaf2}.steps .filled{background:#6159e8;box-shadow:inset 0 2px 0 #8982f3}.sorting-list{margin-top:24px}.bottom{position:fixed;bottom:0;left:0;right:0;padding:16px 20px calc(20px + env(safe-area-inset-bottom));background:#fff;display:flex;gap:12px;border-top:1px solid #eceef4;z-index:5}.bottom .primary{flex:1}.back{background:#fff}
.modes{display:flex;flex-direction:column;gap:16px;margin-top:16px}.mode{min-width:0;box-sizing:border-box;padding:12px 14px 14px;border:2px solid #e2e5ec;border-radius:18px;background:#fff;color:#343b4d}.mode.selected{border-color:#6159e8;background:#f6f5ff;box-shadow:0 3px 0 #d9d6fb}.mode-header{display:flex;align-items:center;flex-wrap:wrap;gap:0 12px;margin-bottom:12px}.mode .mode-choice:not([size=mini]){display:flex;align-items:center;justify-content:flex-start;gap:8px;width:auto;min-height:44px;margin:0;padding:8px 0;border-radius:10px;background:transparent;color:#343b4d;font-size:18px;font-weight:700;line-height:1.5}.mode.selected .mode-choice:not([size=mini]){color:#5149cf}.mode-radio{width:20px;height:20px;border:1.5px solid #b5bac8;border-radius:50%;box-sizing:border-box;flex-shrink:0;background:#fff}.mode-radio.checked{border:6px solid #6159e8}.mode-description{font-size:14px;line-height:1.5;color:#606b7d}.example{border-radius:12px;background:#fff;padding:12px}.example-title{font-size:16px;line-height:1.5;font-weight:600;color:#343b4d}.example-head{display:flex;align-items:center;justify-content:space-between;gap:12px}.example-head .example-title{flex:1;min-width:0}.example-description{font-size:14px;line-height:1.65;margin-top:12px;color:#606b7d}.example-options{display:flex;flex-shrink:0;gap:8px}.example-options text{width:36px;text-align:center;padding:6px 2px;background:#f3f4f8;border-radius:7px;font-size:14px;line-height:20px}.example-options .answer-no{background:#fff0ef;color:#b64451;font-weight:600;border:1px solid #edc3c8;padding:5px 1px}.example-note{display:flex;align-items:baseline;gap:10px;margin-top:12px;padding:10px 12px;border-radius:8px;background:#fff0ef;color:#ae4350;font-size:14px;line-height:1.6;overflow-wrap:anywhere}.note-label{flex-shrink:0;color:#98747a}.detailed-title{margin-bottom:6px}.example-row{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:38px;padding:6px 0;border-bottom:1px solid #edf0f4;font-size:14px;line-height:20px}.example-row:last-child{border-bottom:0}.example-row-label{flex:1;min-width:0}.example-answer{width:28px;flex-shrink:0;text-align:center;border-radius:5px;background:#f0f1fb;color:#6064aa;font-size:14px;line-height:25px}.problem-row{background:#fff0ef;color:#ae4350;margin:0 -6px;padding-left:6px;padding-right:6px;border-radius:6px;border-color:transparent}.example-answer.answer-no{background:#f6dce1;color:#ae4350;font-weight:600}.mode-summary{font-size:13px;line-height:1.6;color:#606b7d;margin:10px 0 0}.selection-hint{text-align:center;font-size:13px;color:#8991a1;margin-top:16px}.comparison-caption{font-size:14px;line-height:1.5;color:#606b7d;margin-top:12px}
.mode-step .welcome-progress{margin-bottom:12px}.mode-step .guide-eyebrow{display:none}.mode-step .guide-title{margin-bottom:0}
@media(max-width:360px){.welcome{padding-left:14px;padding-right:14px}.mode{padding-left:12px;padding-right:12px}.mode-header{gap:0 10px}.mode-description{padding-bottom:4px}.example{padding:10px}}
