page{background:#fff}.welcome{padding:20px 20px 124px;max-width:680px;margin:auto}.welcome-progress{display:flex;gap:16px;align-items:center;margin:4px 0 24px;color:#70788b;font-size:12px;font-weight:600}.steps{display:flex;gap:6px;flex:1}.steps view{height:8px;flex:1;border-radius:8px;background:#e9eaf2}.steps .filled{background:#6159e8;box-shadow:inset 0 2px 0 #8982f3}.sorting-list{margin-top:24px}.bottom{position:fixed;bottom:0;left:0;right:0;padding:16px 20px calc(20px + env(safe-area-inset-bottom));background:#fff;display:flex;gap:12px;border-top:1px solid #eceef4;z-index:5}.bottom .primary{flex:1}.back{background:#fff}
.modes{display:flex;align-items:stretch;gap:12px;margin-top:20px}.mode{flex:1;min-width:0;box-sizing:border-box;display:flex;flex-direction:column;background:#fff;padding:12px 8px 8px;border-radius:18px;border:2px solid #e2e5ec;color:#343b4d}.mode.selected{border-color:#6159e8;background:#f6f5ff;box-shadow:0 3px 0 #d9d6fb}.mode-description{text-align:center;font-size:12px;color:#606b7d;line-height:1.5;margin:6px -4px 12px}.mode-preview{display:block;width:100%;height:auto;border:1px solid #e9eaf2;border-radius:8px;box-sizing:border-box;background:#f5f7fb}.mode-summary{font-size:12px;line-height:1.5;text-align:center;color:#606b7d;margin:12px -4px 8px;flex:1}.mode .mode-choice:not([size=mini]){width:100%;padding:10px 2px;min-height:44px;margin:0;display:flex;align-items:center;justify-content:center;gap:6px;background:#f3f4f8;border-radius:10px;color:#667187;font-size:17px;font-weight:700;line-height:1.5}.mode.selected .mode-choice:not([size=mini]){background:#e9e6ff;color:#5149cf;font-weight:600}.mode-radio{width:18px;height:18px;border:1.5px solid #b5bac8;border-radius:50%;box-sizing:border-box;flex-shrink:0;background:white}.mode-radio.checked{border:5px solid #6159e8}.preview-hint{text-align:center;color:#8991a1;font-size:12px;margin-top:16px}
@media(max-width:360px){.welcome{padding-left:14px;padding-right:14px}.modes{gap:8px}.mode{padding-left:6px;padding-right:6px}.mode .mode-choice:not([size=mini]){font-size:16px}.mode-description,.mode-summary{font-size:11px}}

.mode-step .welcome-progress{margin-bottom:12px}.mode-step .guide-eyebrow{display:none}.mode-step .guide-title{margin-bottom:8px}.mode-step .modes{margin-top:8px}
