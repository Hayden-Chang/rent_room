.editor-label{display:flex;align-items:center;gap:8px;font-size:15px;font-weight:600;margin-bottom:12px}.editor-label .muted{font-weight:400}.required{font-size:11px;font-weight:400;color:#bb4149;background:#fff0ef;padding:2px 6px;border-radius:4px}.note-label{margin-top:24px}.issue-title{width:100%;height:48px}.issue-title.invalid{border-color:#bb4149}.validation{font-size:12px;color:#bb4149;margin-top:6px}.issue-note{min-height:160px;line-height:24px;background:#f5f7fb}.issue-media-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.issue-media{min-width:0;overflow:hidden;border-radius:8px;background:#f5f7fb;margin-bottom:12px}.issue-preview{height:104px}.issue-preview image{width:100%;height:100%}.remove-media{width:100%!important;color:#bb4149;background:#f5f7fb;font-size:12px;border-radius:0}.add-media{width:100%!important;margin-top:4px!important}.editor-actions{position:fixed;left:0;right:0;display:flex;gap:12px;background:#fff;border-top:1px solid #e5e9f1;padding:12px 16px calc(12px + env(safe-area-inset-bottom));z-index:10}.editor-actions.keyboard-open{padding-bottom:12px}.cancel-issue{flex:1}.save-issue{flex:2}

.issue-media-video{grid-column:1 / -1}.issue-video-player{display:block;width:100%;height:190px;background:#111}
