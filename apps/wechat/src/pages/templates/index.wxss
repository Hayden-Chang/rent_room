.template-row{align-items:center;gap:8px}.template-choice:not([size=mini]){width:44px;height:44px;padding:0;font-size:24px;line-height:44px;color:#4d56df;background:transparent}.template-arrow{font-size:24px;color:#667187}
.nav{display:flex;align-items:center;background:#f5f7fb;font-size:17px;font-weight:600}.nav button{margin:0 16px 0 4px;padding:0 15px;font-size:34px;background:transparent;line-height:44px}.nav button::after{border:0}.templates{padding-bottom:100px}.confirm{position:fixed;left:20px;right:20px;bottom:calc(16px + env(safe-area-inset-bottom))}.sheet button{margin-top:12px}
