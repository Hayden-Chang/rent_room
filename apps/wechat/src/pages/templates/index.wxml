<view class="nav" style="padding-top:{{top}}px"><button bindtap="back" aria-label="返回">‹</button><text>模板</text></view>
<view wx:if="{{accountReady}}" class="page templates">
 <view class="card"><view wx:for="{{modes}}" wx:key="id" class="menu template-row" data-mode="{{item.id}}" bindtap="open">
  <text class="grow">{{item.label}}</text><button class="template-choice" data-mode="{{item.id}}" catchtap="choose" aria-label="{{selected===item.id?'已选择':'选择'}}{{item.label}}">{{selected===item.id?'☑':'☐'}}</button><text class="template-arrow">›</text>
 </view></view>
 <button class="primary confirm" bindtap="confirm">确定</button>
</view>
<view wx:if="{{leaveOpen}}" class="mask"><view class="sheet"><view class="subtitle">要更换模板吗？</view><button class="primary" bindtap="confirm">更换并退出</button><button bindtap="discard">不更换并退出</button><button bindtap="stay">继续选择</button></view></view>
<page-container show="{{backGuard}}" overlay="{{false}}" duration="{{0}}" custom-style="height:0;" bindafterleave="guardLeft"/>
