e{height:132px;background:#eceeff;border-radius:12px;position:relative;overflow:hidden}.media-tile image{width:100%;height:100%}.video{text-align:center;padding-top:24px;font-size:30px;color:#4d56df}.video text{display:block;font-size:11px}.media-label{position:absolute;bottom:0;left:0;right:0;background:#1c263888;color:#fff;font-size:10px;padding:4px;text-align:center}

