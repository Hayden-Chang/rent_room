.detail{padding-bottom:180px}.address{margin:8px 0 16px}.progress{margin-top:12px}.track{height:5px;background:#eceeff;margin:14px 0 10px;border-radius:4px;overflow:hidden}.track view{height:5px;background:#4d56df}.issue-text{color:#bb4149}.phases{margin:14px 0}.phases button{flex:1;padding:10px 4px}.filters{background:#fff;padding:12px;border-radius:12px;margin-top:8px}.category{padding:0 16px}.category-head{min-height:64px}.category-head .subtitle{font-size:15px}.circle{width:20px;height:20px;border:1px solid #bbc1cb;border-radius:50%;font-size:12px;text-align:center;line-height:18px;color:#4d56df}.filled{border-color:#4d56df;background:#eceeff}.issue-dot{background:#fff0ef;color:#bb4149;font-size:11px;border-radius:9px;padding:0 5px}.category-body{padding-bottom:12px}.group{border-top:1px solid #e5e9f1;padding:12px 0 4px}.group-title{font-size:14px;font-weight:600;min-height:44px;display:flex;align-items:center;justify-content:space-between}.group-choice{min-height:44px;font-size:13px;padding:12px;background:#f5f7fb}.group-choice.selected{background:#eceeff}.skip{font-size:12px;min-height:44px;padding:10px 8px;background:#f5f7fb}.skip.selected{background:#eceeff}.detail-tabs{position:fixed;bottom:0;left:0;right:0;background:#fff;display:flex;border-top:1px solid #e5e9f1;padding-bottom:env(safe-area-inset-bottom);z-index:20}.detail-tabs button{width:25%;font-size:13px;border-radius:0;color:#667187;height:60px;padding:6px}.detail-tabs .active{color:#4d56df}.tab-icon{font-size:23px;line-height:28px}.floating{position:fixed;right:16px;bottom:calc(78px + env(safe-area-inset-bottom));display:flex;flex-direction:column;gap:12px;z-index:21}.floating button{width:44px;height:44px;border-radius:50%;padding:5px;font-size:24px;box-shadow:0 3px 12px #1c263818}.floating .primary{width:52px;height:52px;font-size:28px}.media-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-bottom:16px}.media-tile{height:132px;background:#eceeff;border-radius:12px;position:relative;overflow:hidden}.media-tile image{width:100%;height:100%}.video{text-align:center;padding-top:24px;font-size:30px;color:#4d56df}.video text{display:block;font-size:11px}.media-label{position:absolute;bottom:0;left:0;right:0;background:#1c263888;color:#fff;font-size:10px;padding:4px;text-align:center}

.tab-icon{display:block;width:24px;height:24px;margin:0 auto 3px}.action-icon{width:24px;height:24px;display:block;margin:auto}.floating button{display:flex;align-items:center;justify-content:center}

.category-head{min-height:56px}.category-head .subtitle{font-size:14px}.detail-tabs button:not([size=mini]){width:25%;height:48px;min-height:48px;padding:2px 0;color:#8d95a3}.detail-tabs button.active{color:#4d56df}.tab-icon{margin-bottom:1px}.floating{align-items:center;bottom:calc(64px + env(safe-area-inset-bottom))}.floating button:not([size=mini]){width:44px;height:44px;min-height:44px;background:#fff;border:1px solid #e5e9f1}.floating .camera-button:not([size=mini]){width:52px;height:52px;min-height:52px}.summary-label{font-size:14px;line-height:20px;margin:8px 0 12px}.decision-segment{display:flex;height:52px;border:1px solid #e5e9f1;border-radius:14px;background:#fff;padding:3px;gap:0}.decision-segment button:not([size=mini]){flex:1;min-width:0;min-height:44px;height:44px;font-size:13px;padding:12px 0;border-radius:10px;color:#667187}.decision-segment .decision-active{background:#4d56df;color:#fff!important}.note-label{margin-top:24px}.summary-note{height:200px;min-height:200px;background:#fff;border:1px solid #e5e9f1;border-radius:16px;padding:16px;font-size:14px;line-height:22px}.media-filters{margin:0 0 16px}.media-filters .chip{min-height:36px;padding:8px 18px}.media-tile{height:114px;border-radius:12px}
.decision-segment button:not([size=mini]){font-weight:400}.decision-segment button.decision-active{font-weight:600}.media-filters .chip{margin:0;font-weight:400}

/* Group choices share the title row, like compact field controls. */
.group-inline{display:flex;align-items:center;gap:8px;padding:2px 0;min-height:48px}
.group-inline .group-main{flex:1;min-width:0}
.group-inline .group-title{min-width:0;gap:6px;line-height:20px;overflow-wrap:anywhere}
.group-inline .group-title .muted{flex-shrink:0}
.group-inline .group-options{flex-shrink:0;flex-wrap:nowrap;gap:4px}
.group-inline .group-choice:not([size=mini]){min-width:44px;min-height:44px;padding:12px 10px;white-space:nowrap}

/* Subtle hierarchy while preserving the original controls. */
.group{margin-top:8px}
.group-inline .group-choice{font-weight:600}
.field-branch{min-width:0}

/* Preserve layout for measurement while hiding the intermediate scroll position. */
.tab-restoring{visibility:hidden;pointer-events:none}

.media-grid{align-items:start;row-gap:16px}
.media-card{min-width:0}
.media-caption,.media-caption:not([size=mini]){display:block;width:100%;min-height:44px;height:auto;padding:8px 2px;background:transparent;border-radius:0;color:#1c2638;font-size:13px;font-weight:400;line-height:20px;text-align:left;white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-all}
.media-caption-add,.media-caption-add:not([size=mini]){color:#8d95a3;font-size:22px;text-align:center}
