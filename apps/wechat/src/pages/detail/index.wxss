.category-head{min-height:56px}.category-head .subtitle{font-size:14px}.detail-tabs button:not([size=mini]){width:25%;height:48px;min-height:48px;padding:2px 0;color:#8d95a3}.detail-tabs button.active{color:#4d56df}.tab-icon{margin-bottom:1px}.floating{align-items:center;bottom:calc(64px + env(safe-area-inset-bottom))}.floating button:not([size=mini]){width:44px;height:44px;min-height:44px;background:#fff;border:1px solid #e5e9f1}.floating .camera-button:not([size=mini]),.floating .add-issue-button:not([size=mini]){width:52px;height:52px;min-height:52px}.summary-label{font-size:14px;line-height:20px;margin:8px 0 12px}.decision-segment{display:flex;height:52px;border:1px solid #e5e9f1;border-radius:14px;background:#fff;padding:3px;gap:0}.decision-segment button:not([size=mini]){flex:1;min-width:0;min-height:44px;height:44px;font-size:13px;padding:12px 0;border-radius:10px;color:#667187}.decision-segment .decision-active{background:#4d56df;color:#fff!important}.note-label{margin-top:24px}.summary-note{height:200px;min-height:200px;background:#fff;border:1px solid #e5e9f1;border-radius:16px;padding:16px;font-size:14px;line-height:22px}.media-filters{margin:0 0 16px}.media-filters .chip{min-height:36px;padding:8px 18px}.media-tile{height:114px;border-radius:12px}
.decision-segment button:not([size=mini]){font-weight:400}.decision-segment button.decision-active{font-weight:600}.media-filters .chip{margin:0;font-weight:400}

/* Group choices share the title row, like compact field controls. */
.group-inline{display:flex;align-items:center;gap:8px;padding:2px 0;min-height:48px}
.group-inline .group-main{flex:1;min-width:0}
.group-inline .group-title{min-width:0;gap:6px;line-height:20px;overflow-wrap:anywhere}
.group-inline .group-title .muted{flex-shrink:0}
.group-inline .group-options{flex-shrink:0;flex-wrap:nowrap;gap:4px}
.group-inline .group-choice:not([size=mini]){min-width:44px;min-height:44px;padding:12px 10px;white-space:nowrap}

/* Subtle hierarchy while preserving the original controls. */
.group{margin-top:8px}
.group-inline .group-choice{font-weight:600}
.field-branch{min-width:0}
.add-cost-row{display:flex;justify-content:center;min-height:44px}
.add-cost,.add-cost:not([size=mini]){width:44px;height:44px;min-height:44px;padding:0;background:transparent;color:#8d95a3;font-size:24px;line-height:44px;font-weight:400}

/* Preserve layout for measurement while hiding the intermediate scroll position. */
.tab-restoring{visibility:hidden;pointer-events:none}

/* Figma coachmarks, anchored to measured controls in the current checklist. */
.coach-layer{position:fixed;inset:0;z-index:1000;overflow:hidden}
.coach-dim{position:absolute;inset:0;background:#1c263899}
.coach-highlight{position:absolute;box-sizing:border-box;border:2px solid #fff;border-radius:26px;box-shadow:0 0 0 2000px #1c263899;pointer-events:none}
.coach-highlight-row{border-radius:10px}
.coach-pointer{position:absolute;width:2px;background:#fff}
.coach-card{position:absolute;left:16px;right:16px;box-sizing:border-box;min-height:196px;padding:14px 16px 12px;border-radius:16px;background:#fff;color:#1c2638;display:flex;flex-direction:column;max-height:calc(100% - 24px);overflow-y:auto}
.coach-measuring .coach-card{visibility:hidden;top:16px}
.coach-step{font-size:12px;line-height:20px;color:#667187;padding:0 2px}
.coach-title{font-size:17px;line-height:28px;font-weight:600;margin-top:5px;padding:0 2px}
.coach-body{font-size:14px;line-height:22px;color:#667187;white-space:pre-line;min-height:48px;margin-top:5px;padding:0 2px}
.coach-card .coach-next:not([size=mini]){width:100%;height:44px;min-height:44px;flex-shrink:0;background:#4d56df;color:#fff;border-radius:10px;font-size:15px;font-weight:600;line-height:22px;padding:11px 0;margin:20px 0 0}
.coach-card-last{min-height:220px}
.coach-card-last .coach-next:not([size=mini]){margin-top:8px}
.coach-preference{display:flex;align-items:center;gap:10px;width:180px;min-height:36px;color:#667187;font-size:13px;line-height:22px}
.coach-checkbox{box-sizing:border-box;width:18px;height:18px;border:1.2px solid #667187;border-radius:4px;line-height:16px;text-align:center}
.coach-checked{background:#4d56df;border-color:#4d56df;color:white}
.coach-demo{position:absolute;height:48px;background:white;border-radius:10px;overflow:hidden;display:flex;align-items:center}
.coach-demo-label{padding:0 8px;font-size:13px;line-height:22px;color:#1c2638;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;width:100%;box-sizing:border-box;transition:width 450ms ease}
.coach-demo-open{width:calc(100% - 132px)}
.coach-demo-actions{display:flex;position:absolute;right:0;top:2px;transform:translateX(100%);transition:transform 450ms ease}
.coach-demo-actions-open{transform:translateX(0)}
.coach-demo-action{width:44px;height:44px;display:flex;align-items:center;justify-content:center}.coach-demo-actions image{width:26px;height:26px}
.coach-error{color:#bb4149;font-size:13px;line-height:20px;margin-top:4px}

.coach-demo-actions image.coach-media-icon{width:22px;height:22px}
.media-grid{align-items:start;row-gap:16px}
.media-card{min-width:0}
.media-caption,.media-caption:not([size=mini]){display:block;width:100%;min-height:44px;height:auto;padding:8px 2px;background:transparent;border-radius:0;color:#1c2638;font-size:13px;font-weight:400;line-height:20px;text-align:left;white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-all}
.media-caption-add,.media-caption-add:not([size=mini]){color:#8d95a3;font-size:22px;text-align:center}

.manual-title{font-weight:600;word-break:break-all}.manual-note{display:block;white-space:pre-wrap;word-break:break-all;line-height:22px;margin-top:10px}.manual-meta{font-size:12px;color:#667187;margin-top:10px}.media-label{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

.manual-media-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:12px}.manual-media{min-width:0;height:96px;overflow:hidden;border-radius:8px;background:#eef0f5}.manual-photo{width:100%;height:100%}.manual-media-video{grid-column:1 / -1;height:190px;background:#111}.manual-video{display:block;width:100%;height:190px}
/* Keep native-input geometry stable while moving the sheet above the keyboard. */
.note-sheet{position:absolute;display:flex;flex-direction:column;padding:12px 20px max(8px,env(safe-area-inset-bottom));overflow:visible}
.note-sheet .subtitle,.note-sheet .row{flex-shrink:0}
.note-sheet textarea{height:160px;min-height:48px;flex:1 1 160px}
.note-sheet .subtitle{margin-bottom:12px}
.note-sheet .row{margin-top:12px}

.filter-toggle{display:flex;align-items:center;justify-content:center;gap:8px;white-space:nowrap}.filter-chevron{width:7px;height:7px;border-right:2px solid currentColor;border-bottom:2px solid currentColor;transform:rotate(45deg);margin-top:-4px}.filter-chevron.open{transform:rotate(225deg);margin-top:4px}

.xiaoda-coach{position:fixed;inset:0;z-index:500;pointer-events:none}.coach-shade{position:absolute;background:#1b234957;pointer-events:auto}.coach-shade.full{inset:0}.xiaoda-highlight{position:absolute;border:2px solid #6763ed;border-radius:12px;box-sizing:border-box;pointer-events:none}.xiaoda-coach-card{pointer-events:auto;left:12px;right:12px;padding:20px;background:#fff;border-radius:24px;border:2px solid #e2e5ec}.xiaoda-coach-card .primary{margin-top:20px;width:100%}/* Companion guidance is a sibling of its target, never checklist content. */
.fill-guide{position:relative;background:transparent;transition:height 240ms ease;overflow:hidden}
.fill-content{padding:28px 0 24px;opacity:1;transform:translateY(0);transition:opacity 220ms ease,transform 220ms ease}
.fill-preparing .fill-content,.fill-moving .fill-content{opacity:0;transform:translateY(8px);pointer-events:none}
.fill-entering .fill-content{pointer-events:none}
.fill-ready{overflow:visible}
.fill-shifting{overflow-anchor:none}
.fill-leaving{transition:height 280ms ease;pointer-events:none}
.fill-leaving .fill-content{opacity:0;transform:translateY(-4px);transition:opacity 160ms ease,transform 160ms ease;pointer-events:none}
.fill-category-target .category-head{position:relative}
.fill-category-target .category-head::before{content:"";position:absolute;left:-16px;top:18px;width:3px;height:24px;border-radius:0 3px 3px 0;background:#6763ed}
.fill-phase-target{box-shadow:inset 0 0 0 2px #6763ed}
.fill-destination{color:#5250b5;font-weight:600;font-size:13px;margin:0 24px 0 84px}
.fill-actions{display:flex;align-items:center;gap:8px;margin:16px 0 0;white-space:normal}
.fill-actions button:not([size=mini]){flex:1;min-width:0;margin:0;font-size:14px;min-height:44px;padding:10px 4px}
.fill-actions .guide-primary:not([size=mini]){border-radius:12px;box-shadow:0 3px 0 #3836b3}
.fill-actions .guide-secondary:not([size=mini]){background:transparent}
.fill-return{position:fixed;left:16px;right:16px;bottom:calc(76px + env(safe-area-inset-bottom));z-index:30;padding:0;max-height:60vh;overflow:auto;margin:0}
.fill-return .fill-content{padding:12px 0 4px}
.coach-progress{display:flex;align-items:center;gap:12px;font-size:12px;font-weight:600;color:#70788b}.coach-dots{display:flex;gap:6px;flex:1}.coach-dots view{height:6px;border-radius:6px;background:#e9eaf2;flex:1}.coach-dots .done{background:#6159e8}.coach-heading{font-size:21px;font-weight:700;margin:12px 0 16px;color:#30394c}
.progress-meta{justify-content:flex-end}
