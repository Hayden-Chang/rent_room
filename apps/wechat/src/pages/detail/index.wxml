<view wx:if="{{house}}" bindtap="dismissSwipe">
 <view wx:if="{{house.archived}}" class="readonly">归档房源 · 只读查看，在归档列表中可还原</view>
 <view class="page detail {{restoringTab?'tab-restoring':''}}">
  <view wx:if="{{saveError}}" class="error" bindtap="retry">{{saveError}} 点击重试</view>
  <block wx:if="{{tab==='清单'}}">
   <view class="card progress"><view class="row between"><text class="subtitle">现场检查</text><text>{{stats.done}} / {{stats.total}}</text></view><view class="track"><view style="width:{{stats.total?stats.done/stats.total*100:0}}%"/></view><view class="row between muted"><text>已记录 {{stats.done}} 项</text><text class="issue-text">{{stats.issues}} 项有问题</text></view></view>
   <view class="row phases"><button wx:for="{{phases}}" wx:key="*this" class="chip {{phase===item?'selected':''}}" data-value="{{item}}" hover-class="none" bindtap="phase">{{item}}</button></view>
   <view class="row"><input class="grow" placeholder="搜索检查项、结果或备注" value="{{query}}" bindinput="search"/><button class="soft" hover-class="none" bindtap="toggleFilters">筛选 {{filters.length||''}}</button></view>
   <view wx:if="{{showFilters}}" class="chips filters"><button class="chip {{!filters.length?'selected':''}}" data-value="全部" hover-class="none" bindtap="filter">全部</button><button wx:for="{{filterOptions}}" wx:key="label" class="chip {{item.selected?'selected':''}}" data-value="{{item.label}}" hover-class="none" bindtap="filter">{{item.label}}</button></view>
   <view class="space"/>
   <view wx:for="{{sections}}" wx:for-item="section" wx:key="title" class="card category" id="{{section.id}}">
    <view class="row category-head scroll-anchor" data-scroll-key="category-{{section.title}}" data-id="{{section.title}}" data-expanded="{{section.expanded}}" bindtap="fold"><text class="grow subtitle">{{section.title}}</text><text class="muted">{{section.stats.done}} / {{section.stats.total}}</text><text wx:if="{{section.stats.issues}}" class="issue-dot">{{section.stats.issues}}</text><text class="muted">{{section.expanded?'⌃':'⌄'}}</text></view>
    <view wx:if="{{section.expanded}}" class="category-body"><block wx:for="{{section.rows}}" wx:for-item="r" wx:key="key">
     <view wx:if="{{r.kind==='group'}}" data-scroll-key="group-{{r.id}}" class="scroll-anchor group {{r.options.length>0?'group-inline':''}}" style="margin-left:{{r.depth>2?24:r.depth*12}}px"><view class="row group-main"><view class="grow group-title" data-id="{{r.id}}" data-expanded="{{r.expanded}}" bindtap="fold">{{r.title}} <text class="muted">{{r.expanded?'⌃':'⌄'}}</text></view><button wx:if="{{r.skippable}}" class="skip {{r.skipped?'selected':''}}" disabled="{{house.archived}}" data-id="{{r.id}}" data-op="skip" bindtap="group">不涉及</button></view><view wx:if="{{!r.skipped}}" class="chips group-options"><button wx:for="{{r.options}}" wx:key="value" class="group-choice {{item.selected?'selected':''}}" disabled="{{house.archived}}" data-id="{{r.id}}" data-value="{{item.value}}" data-op="value" bindtap="group">{{item.label||item.value}}</button></view></view>
     <view wx:else class="field-branch scroll-anchor" data-scroll-key="field-{{r.key}}" style="margin-left:{{r.depth>2?24:r.depth*12}}px"><field-row class="field-row" field="{{r}}" hide-divider="{{section.rows[index+1] && section.rows[index+1].kind==='group'}}" readonly="{{house.archived}}" address="{{house.address}}" location="{{house.location}}" anchor="{{house.locationAddress}}" bindselectplace="selectPlace" bindanswer="answer" bindchoose="choose" bindaction="action"/></view>
    </block></view>
   </view>
   <view wx:if="{{!sections.length}}" class="empty">没有符合条件的检查项</view><button wx:if="{{!house.archived}}" class="link" bindtap="custom">＋ 自定义检查</button>
  </block>
  <block wx:if="{{tab==='影像'}}"><view class="chips media-filters"><button wx:for="{{mediaFilters}}" wx:key="value" class="chip {{mediaType===item.value?'selected':''}}" data-value="{{item.value}}" hover-class="none" bindtap="mediaFilter">{{item.label}}</button></view><view wx:if="{{!house.media.length}}" class="empty"><view class="subtitle">还没有影像</view>把房间、细节和需要确认的地方拍下来。</view><view class="media-grid"><view wx:for="{{visibleMedia}}" wx:key="id" class="media-card">
   <view class="media-tile" data-id="{{item.id}}" bindtap="preview" bindlongpress="mediaManage"><image wx:if="{{item.type==='image'}}" src="{{item.path}}" mode="aspectFill"/><view wx:else class="video">▶<text>视频 {{item.duration}}s</text></view><text class="media-label">{{item.fieldId?'已关联检查项':'房源影像'}}</text></view>
   <text wx:if="{{house.archived && item.caption}}" class="media-caption">{{item.caption}}</text>
   <button wx:elif="{{!house.archived}}" class="media-caption {{item.caption?'':'media-caption-add'}}" data-id="{{item.id}}" bindtap="editMediaNote" aria-label="{{item.caption?'编辑影像备注':'添加影像备注'}}" hover-class="none">{{item.caption||'＋'}}</button>
  </view></view></block>
  <block wx:if="{{tab==='问题'}}"><view class="row between section-title"><text>需要关注 · {{stats.issues}}</text><button wx:if="{{!house.archived}}" class="soft" bindtap="addIssue">＋ 新问题</button></view><view wx:if="{{!issueRows.length&&!manualIssues.length}}" class="empty"><view class="subtitle">目前没有标记的问题</view>未检查的项目仍需继续查看。</view><view wx:for="{{issueRows}}" wx:key="id" class="card"><text class="muted">{{item.category}}</text><field-row class="field-row" field="{{item}}" readonly="{{house.archived||item.groupRole}}" address="{{house.address}}" location="{{house.location}}" anchor="{{house.locationAddress}}" bindselectplace="selectPlace" bindanswer="answer" bindchoose="choose" bindaction="action"/></view><view wx:for="{{manualIssues}}" wx:key="id" class="card row"><text class="grow">{{item.title}}</text><button disabled="{{house.archived}}" class="{{item.resolved?'soft':'danger'}}" data-id="{{item.id}}" bindtap="resolve">{{item.resolved?'已解决':'待跟进'}}</button></view></block>
  <block wx:if="{{tab==='总结'}}"><view class="summary-label">当前意向</view><view class="decision-segment"><button wx:for="{{['考虑租住','继续比较','放弃']}}" wx:key="*this" class="{{house.decision===item?'decision-active':''}}" disabled="{{house.archived}}" data-value="{{item}}" bindtap="decision">{{item==='放弃'?'放弃这套':item}}</button></view><view class="summary-label note-label">备注</view><textarea class="summary-note" value="{{house.summary}}" maxlength="10000" placeholder="记录下你对这套房源的整体感受…" disabled="{{house.archived}}" bindinput="summary"/><view wx:if="{{saveError}}" class="error">尚未保存，请重试</view></block>
 </view>
 <view class="floating" wx:if="{{tab==='清单'||tab==='影像'}}"><button wx:if="{{tab==='清单'}}" bindtap="top" aria-label="回到顶部"><image src="/assets/icons/up.png" class="action-icon"/></button><button wx:if="{{!house.archived}}" class="camera-button" bindtap="capture" aria-label="拍照或录视频"><image src="/assets/icons/camera.png" class="action-icon"/></button></view>
 <view class="detail-tabs"><button wx:for="{{tabs}}" wx:key="*this" class="{{tab===item?'active':''}}" data-value="{{item}}" bindtap="tab"><image class="tab-icon" src="/assets/icons/{{item==='清单'?'checklist':item==='影像'?'media':item==='问题'?'issues':'summary'}}-{{tab===item?'selected':'default'}}.png"/>{{item}}{{item==='影像'?' '+house.media.length:item==='问题'?' '+stats.issues:''}}</button></view>
 <view wx:if="{{sheet}}" class="mask" bindtap="close"><view class="sheet" catchtap="noop">
  <block wx:if="{{sheet==='note'}}"><view class="subtitle">{{noteTitle}} · 备注</view><textarea value="{{note}}" disabled="{{house.archived}}" maxlength="10000" bindinput="note" auto-focus/><view class="row"><button bindtap="close">{{house.archived?'关闭':'取消'}}</button><button wx:if="{{!house.archived}}" class="primary" bindtap="saveNote">保存备注</button></view></block>
  <block wx:if="{{sheet==='mediaNote'}}"><view class="subtitle">影像备注</view><textarea class="media-note-input" value="{{note}}" disabled="{{house.archived}}" maxlength="10000" placeholder="添加标题或备注，可换行" bindinput="note" auto-focus/><view wx:if="{{saveError}}" class="error">{{saveError}}</view><view class="row"><button bindtap="close">取消</button><button wx:if="{{!house.archived}}" class="primary" bindtap="saveMediaNote">保存备注</button></view></block>
  <block wx:if="{{sheet==='link'}}"><view class="subtitle">关联检查项</view><input placeholder="搜索检查项" value="{{linkQuery}}" bindinput="linkSearch"/><scroll-view scroll-y style="height:45vh"><button wx:for="{{linkFields}}" wx:key="id" class="menu" data-id="{{item.id}}" bindtap="linkMedia">{{item.label}}</button></scroll-view></block>
 </view></view>
 <view wx:if="{{coach}}" class="mask"><view class="sheet"><view class="muted">快速上手 {{coach}} / 4</view><view class="subtitle">{{coachTexts[coach-1]}}</view><view class="row between"><text>下次不再自动显示</text><switch checked="{{hideCoach}}" color="#4D56DF" bindchange="hideCoach"/></view><view class="space"/><button class="primary" bindtap="coachNext">{{coach===4?'开始记录':'知道了，下一步'}}</button></view></view>
</view>
