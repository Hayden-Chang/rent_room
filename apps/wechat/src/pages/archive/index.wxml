<view hidden="{{!accountReady}}">
<view class="page"><view wx:if="{{!houses.length}}" class="empty">还没有归档房源</view><view class="grid"><view wx:for="{{houses}}" wx:key="id" class="house" data-id="{{item.id}}" bindtap="open" bindlongpress="manage"><view class="cover"><image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill"/><view wx:else class="placeholder"><image src="/assets/icons/home-selected.png"/></view><text class="badge status">已归档</text></view><view class="house-body"><view class="house-name">{{item.name}}</view><view class="money">{{item.rent==='—'?'租金待填写':'¥ '+item.rent+' / 月'}}</view><view class="muted address">{{item.address||'地址待填写'}} · {{item.area}}m²</view><view class="muted">{{item.stats.issues}} 个问题</view></view></view></view><view wx:if="{{houses.length}}" class="hint">长按房源可还原或删除</view></view>

</view>
<view wx:if="{{!accountReady}}" class="auth-wait">正在确认登录状态…</view>
