.commute-page{padding-bottom:120px}.endpoints{padding:4px 16px}.endpoint{display:flex;align-items:center;gap:12px;width:100%;margin:0;padding:14px 0;text-align:left;background:transparent;line-height:22px;border-radius:0;font-weight:400}.endpoint::after,.route-option::after{border:0}.point{flex-shrink:0;width:26px;height:26px;line-height:26px;border-radius:50%;font-size:12px;text-align:center}.origin-point{background:#eceeff;color:#4d56df}.destination-point{background:#e4f3ed;color:#247b5b}.endpoint-main{flex:1;min-width:0}.endpoint-label{display:block;color:#667187;font-size:11px}.endpoint-address{display:block;font-size:14px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}.endpoint-edit{flex-shrink:0;color:#4d56df;font-size:12px}.endpoint-divider{height:1px;background:#e5e9f1;margin-left:38px}.missing-point{display:block;font-size:11px;color:#bb4149}.route-map-card{overflow:hidden;border-radius:14px;margin-bottom:16px;background:#eceeff}.route-map,.map-placeholder{width:100%;height:240px}.map-placeholder{display:flex;align-items:center;justify-content:center;color:#667187;font-size:13px;padding:24px;box-sizing:border-box}.route-toolbar{display:flex;justify-content:flex-end;margin:0 0 8px}.route-toolbar .link{font-size:13px;padding:4px 0 4px 12px;margin:0}.route-status,.route-message{font-size:13px;line-height:22px;color:#667187}.route-option{display:block;width:100%;margin:0 0 12px;padding:16px;text-align:left;border:1px solid #e5e9f1;border-radius:14px;background:#fff;font-weight:400;line-height:22px;box-sizing:border-box}.route-selected{border-color:#4d56df;background:#f4f4ff}.route-duration{font-size:26px;line-height:34px;font-weight:600;color:#1c2638}.minute-unit{font-size:13px;font-weight:400}.route-radio{color:#4d56df;font-size:20px}.route-title{font-size:14px;margin:6px 0}.route-meta{font-size:12px;color:#667187}.commute-footer{position:fixed;bottom:0;left:0;right:0;display:flex;gap:12px;padding:14px 20px;padding-bottom:calc(14px + env(safe-area-inset-bottom));background:#fff;border-top:1px solid #e5e9f1;z-index:5}.commute-footer button{margin:0;min-height:46px;font-size:14px;line-height:24px}.route-cancel{flex:1}.route-confirm{flex:2}.route-confirm[disabled]{background:#dce0e9;color:#8792a5}.picker-cancel{font-size:13px}
