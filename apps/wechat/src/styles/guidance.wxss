.guide-eyebrow{font-size:12px;font-weight:600;color:#70788b;letter-spacing:1px}.guide-title{font-size:24px;line-height:1.4;font-weight:700;color:#263047;margin:8px 0 20px}.guide-primary:not([size=mini]){min-height:50px;padding:12px 18px;border-radius:14px;background:#5250dc;color:#fff;font-size:16px;font-weight:700;line-height:1.5;box-shadow:0 4px 0 #3836b3;border:0}.guide-primary[disabled]{background:#e5e7ed;color:#858b9a;box-shadow:0 4px 0 #d5d8e0;opacity:1}.guide-pressed{opacity:.88;transform:translateY(2px);box-shadow:0 2px 0 #3836b3}.guide-secondary:not([size=mini]){min-height:48px;padding:12px 16px;background:transparent;color:#555bc1;font-size:15px;font-weight:600;border-radius:12px}.guide-secondary[disabled]{color:#858b9a;opacity:1}.guide-check{width:22px;height:22px;background:#39845b;border-radius:50%;position:relative;flex-shrink:0}.guide-check::after{content:"";position:absolute;width:9px;height:5px;left:6px;top:6px;border:2px solid white;border-top:0;border-right:0;transform:rotate(-45deg)}
