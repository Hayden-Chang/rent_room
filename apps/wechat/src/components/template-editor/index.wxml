<view class="template-list"><view wx:for="{{rows}}" wx:key="title" class="template-row {{item.disabled?'disabled':''}} {{dragging===item.title?'dragging':''}}"><view class="handle" data-title="{{item.title}}" bindtouchstart="start" catchtouchmove="move" bindtouchend="end" bindtouchcancel="end" aria-label="拖动{{item.title}}">☰</view><text class="title">{{item.title}}</text><button class="toggle" data-title="{{item.title}}" bindtap="toggle" aria-label="{{item.disabled?'恢复':'停用'}}{{item.title}}"><text wx:if="{{item.disabled}}">↶</text><view wx:else class="trash-icon" aria-hidden="true"><view class="trash-lid"/><view class="trash-can"><view/><view/></view></view></button></view></view><view wx:if="{{error}}" class="error">{{error}}</view>
