.template-list{border-radius:18px;overflow:hidden;background:#fff}.template-row{height:58px;display:flex;align-items:center;border-bottom:1px solid #eef0f6;color:#29324b}.handle{padding:18px;color:#9a9eb2;font-size:20px}.title{flex:1;font-size:16px}.template-row .toggle{display:flex;align-items:center;justify-content:center;flex-shrink:0;background:transparent;color:#898ca4;font-size:23px;width:48px;height:48px;line-height:normal;margin:0 12px 0 8px;padding:0}.toggle::after{border:0}.disabled .title{color:#b6b9c6;text-decoration:line-through}.disabled{background:#f8f9fc}.dragging{background:#eeefff;box-shadow:inset 3px 0 #4d56df}.error{padding:12px;color:#c64a55;font-size:14px}

.trash-icon{position:relative;width:24px;height:24px;color:#d94b55}.trash-lid{position:absolute;top:5px;left:3px;right:3px;border-top:2px solid currentColor}.trash-lid::before{content:"";position:absolute;top:-5px;left:5px;width:8px;height:5px;border:2px solid currentColor;border-bottom:0;border-radius:2px 2px 0 0;box-sizing:border-box}.trash-can{position:absolute;top:5px;bottom:2px;left:5px;right:5px;border:2px solid currentColor;border-top:0;border-radius:0 0 3px 3px;display:flex;justify-content:center;gap:4px;padding-top:4px;box-sizing:border-box}.trash-can view{width:2px;height:8px;border-radius:1px;background:currentColor}
