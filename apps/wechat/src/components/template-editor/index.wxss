.template-list{border-radius:18px;overflow:hidden;background:#fff}.template-row{height:58px;display:flex;align-items:center;border-bottom:1px solid #eef0f6;color:#29324b}.handle{padding:18px;color:#9a9eb2;font-size:20px}.title{flex:1;font-size:16px}.toggle{background:transparent;color:#898ca4;font-size:23px;width:52px;padding:0}.toggle::after{border:0}.disabled .title{color:#b6b9c6;text-decoration:line-through}.disabled{background:#f8f9fc}.dragging{background:#eeefff;box-shadow:inset 3px 0 #4d56df}.error{padding:12px;color:#c64a55;font-size:14px}
