<view class="address-picker" catchtap="noop">
 <view wx:if="{{!readonly}}" class="search-bar"><input class="address-search" aria-label="搜索地址" placeholder="搜索地址，更快填写" value="{{query}}" bindfocus="focus" bindinput="input" maxlength="200"/><button wx:if="{{query}}" class="clear" bindtap="clear" aria-label="清空搜索">×</button></view>
 <scroll-view wx:if="{{(mode==='search'||mode==='manual')&&items.length}}" scroll-y class="search-results"><view wx:for="{{items}}" wx:key="id" class="result" data-id="{{item.id}}" bindtap="use"><view class="result-main"><view class="name">{{item.name}}</view><view class="address">{{item.distanceText}} {{item.address}}</view></view><text class="choose">选择</text></view></scroll-view>
 <button wx:if="{{!readonly}}" class="map-toggle" bindtap="toggleMap" aria-expanded="{{!collapsed}}">{{collapsed?'展开地图':'收起地图'}} <text>{{collapsed?'⌄':'⌃'}}</text></button>
 <view wx:if="{{!collapsed}}" class="map-wrap">
  <map wx:if="{{center}}" id="address-map" latitude="{{center.latitude}}" longitude="{{center.longitude}}" scale="{{scale}}" enable-scroll="{{!readonly}}" enable-zoom="{{true}}" enable-rotate="{{false}}" enable-poi="{{false}}" show-location="{{false}}" bindregionchange="region" class="map"/>
  <view wx:else class="map-empty">{{busy?'正在匹配地址位置':emptyText}}</view>
  <cover-view wx:if="{{center}}" class="center-pin">●</cover-view>
  <cover-view wx:if="{{!readonly}}" class="locate" bindtap="locate" aria-label="定位到当前位置">定位</cover-view>
 <scroll-view wx:if="{{mode==='nearby'&&items.length}}" scroll-y class="nearby-results"><view wx:for="{{items}}" wx:key="id" class="result"><view class="result-main"><view class="name">{{item.name}}</view><view class="address">{{item.distanceText}} {{item.address}}</view></view><button class="use" data-id="{{item.id}}" bindtap="use">使用</button></view></scroll-view>
 </view>
 <view wx:if="{{busy}}" class="status">正在查找地点…</view>
 <view wx:if="{{!collapsed&&(center||items.length)}}" class="attribution">地点信息来源：天地图</view>
 <view wx:if="{{message}}" class="status">{{message}} <button wx:if="{{locationAction==='settings'&&!readonly}}" class="permission-settings" open-type="openSetting" bindtap="settingsStart" bindopensetting="settingsChanged">去设置开启</button><text wx:else class="retry" bindtap="retry">重试</text></view>
</view>
