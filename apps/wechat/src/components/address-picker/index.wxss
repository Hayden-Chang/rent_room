.address-picker{position:relative;margin:4px 0 10px;color:#253047}.search-bar{display:flex;align-items:center;border-radius:10px;background:#F2F3FA;margin-bottom:10px;padding:0 12px;min-height:44px}.address-search{flex:1;min-width:0;font-size:14px;height:44px}.clear{font-size:22px;background:transparent;width:32px;margin:0;padding:0;line-height:32px}.clear::after,.use::after{border:0}.map-wrap{position:relative;height:300px;overflow:hidden;border-radius:10px;background:#F2F4F7}.map{width:100%;height:100%}.map-empty{padding:65px 20px;text-align:center;color:#667187;font-size:13px}.center-pin{position:absolute;top:50%;left:50%;margin:-12px 0 0 -12px;width:24px;height:24px;line-height:24px;text-align:center;color:#4D56DF;background:#fff;border-radius:50%;font-size:22px;pointer-events:none}.locate{position:absolute;right:12px;top:12px;background:#fff;border:1px solid #DFE3ED;border-radius:8px;padding:10px;font-size:13px;color:#4D56DF}.search-results{height:230px;margin-bottom:10px;border:1px solid #E7EAF2;border-radius:8px;box-sizing:border-box}.nearby-results{position:absolute;bottom:0;left:0;right:0;width:100%;height:128px;background:#fff;border:1px solid #E7EAF2;border-radius:0 0 10px 10px;box-sizing:border-box}.result{display:flex;align-items:center;gap:10px;min-height:52px;padding:10px 12px;border-bottom:1px solid #EFF1F6}.result-main{flex:1;min-width:0}.name{font-size:14px;font-weight:500}.address{font-size:12px;line-height:18px;color:#667187;margin-top:3px}.use{width:auto;flex:none;padding:0 12px;margin:0;font-size:13px;line-height:32px;background:#EFF0FF;color:#4D56DF;border-radius:6px}.choose,.retry{color:#4D56DF;font-size:13px}.status{font-size:12px;line-height:20px;color:#667187;padding:8px 2px}

.attribution{font-size:10px;color:#8991A1;text-align:right;padding-top:3px}

.permission-settings{display:block;width:max-content;margin:8px 0 0;padding:0 14px;line-height:36px;font-size:13px;color:#4D56DF;background:#EFF0FF;border-radius:8px}.permission-settings::after{border:0}
