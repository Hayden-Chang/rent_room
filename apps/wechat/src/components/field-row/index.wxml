<view class="field {{hideDivider?'hide-divider':''}} {{readonly?'readonly':''}} {{field.problem?'bad':''}} {{field.inline?'inline':''}} {{!field.map&&field.type==='t'?'text-field':''}} {{field.type==='n'?'number-field':''}}" bindtouchstart="bodyStart" catchtap="noop">
 <address-picker wx:if="{{field.map}}" address="{{address}}" location="{{location}}" anchor="{{anchor}}" readonly="{{readonly}}" bindselect="selectPlace"/>
 <view wx:if="{{!field.map}}" class="swipe-shell {{actions||dragging?'actions-open':''}}">
 <view wx:if="{{!readonly}}" class="swipe-tray {{dragging?'dragging':''}}" catchtouchstart="start" bindtouchmove="move" bindtouchend="end" bindtouchcancel="cancel" catchtap="tapHead" style="transform:translateX({{132+offset}}px);visibility:{{offset<0?'visible':'hidden'}}" aria-hidden="{{!actions}}"><button class="control swipe-action flag {{field.problem?'flag-active':''}}" aria-label="{{field.problem?'取消问题':'标记问题'}}" data-tray="true" catchtouchstart="start" data-action="flag" catchtap="trayAction" disabled="{{!actions}}"><image class="swipe-icon" src="/assets/icons/{{field.problem?'swipe-issue-active':'swipe-issue'}}.png" mode="aspectFit" aria-hidden="true"/></button><button class="control swipe-action note-action" aria-label="备注" data-tray="true" catchtouchstart="start" data-action="note" catchtap="trayAction" disabled="{{!actions}}"><image class="swipe-icon" src="/assets/icons/swipe-note.png" mode="aspectFit" aria-hidden="true"/></button><button class="control swipe-action media-action" aria-label="拍摄" data-tray="true" catchtouchstart="start" data-action="media" catchtap="trayAction" disabled="{{!actions}}"><image class="swipe-icon" src="/assets/icons/swipe-camera.png" mode="aspectFit" aria-hidden="true"/></button></view>
 <view class="head swipe-front" catchtouchstart="start" bindtouchmove="move" bindtouchend="end" bindtouchcancel="cancel" catchtap="tapHead" bindlongpress="reveal" aria-label="{{field.label}}，左滑或长按显示操作"><text class="label">{{field.label}}<text wx:if="{{field.multiple}}" class="muted"> · 多选</text></text></view>
 <view wx:if="{{field.options.length}}" class="answer-options {{field.inline && offset<0?'options-retracted':''}}" catchtouchstart="start" bindtouchmove="move" bindtouchend="end" bindtouchcancel="cancel" catchtap="tapHead" aria-hidden="{{field.inline && offset<0}}"><view class="choices {{dragging?'dragging':''}}" style="transform:translateX({{field.inline?offset/132*100:0}}%)"><button wx:for="{{field.options}}" wx:key="value" class="control choice {{item.selected?'selected':''}}" data-value="{{item.value}}" disabled="{{readonly}}" bindtap="choose">{{item.label||item.value}}</button></view></view>
 <picker wx:elif="{{field.type==='d'}}" mode="date" value="{{field.value}}" disabled="{{readonly}}" bindchange="input"><view class="input">{{field.value||'选择日期'}}</view></picker>
 <input wx:else class="input" type="{{field.type==='n'?'digit':'text'}}" value="{{field.value}}" placeholder="{{valueFocused||valueFilled?'':field.type==='n'?'填写数值':'填写信息'}}" data-input="value" bindfocus="handleInputFocus" bindblur="handleInputBlur" maxlength="2000" disabled="{{readonly}}" bindinput="input"/>
 </view>
 <input wx:if="{{field.other}}" class="input other" placeholder="{{otherFocused||otherFilled?'':'请填写其他内容'}}" data-input="other" bindfocus="handleInputFocus" bindblur="handleInputBlur" value="{{field.otherText}}" maxlength="2000" disabled="{{readonly}}" bindinput="other"/>
 <view wx:if="{{field.note}}" class="note" data-action="note" bindtap="action">{{field.note}}</view><view wx:if="{{field.photoRef}}" class="muted">原照片编号：{{field.photoRef}}</view>
 <view wx:if="{{field.media.length}}" class="thumbs"><view wx:for="{{field.thumbnails}}" wx:key="id" class="thumb" data-action="preview" bindtap="action"><image class="thumbnail" wx:if="{{item.type==='image'}}" src="{{item.path}}" mode="aspectFill"/><text wx:else>▶ 视频</text></view><view wx:if="{{field.media.length>3}}" class="thumb" data-action="preview" bindtap="action">+{{field.media.length-3}}</view></view>
</view>
