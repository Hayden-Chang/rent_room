<view class="field {{field.heading?'heading '+field.heading:''}} {{speedTest?'speed-field':''}} {{commute?'commute-field':''}} {{hideDivider?'hide-divider':''}} {{readonly?'readonly':''}} {{field.problem?'bad':''}} {{field.inline?'inline':''}} {{!field.heading&&!field.map&&field.type==='t'?'text-field':''}} {{field.type==='n'?'number-field':''}}" catchtap="noop">
 <!-- Observe the full row without catching native input touchstart. -->
 <view wx:if="{{!field.map}}" class="swipe-shell {{actions||dragging?'actions-open':''}}" bindtouchstart="start" capture-bind:touchmove="move" catchtouchmove="{{dragging?'noop':''}}" bindtouchend="end" bindtouchcancel="cancel" catchtap="tapHead">
 <view wx:if="{{!readonly}}" class="swipe-tray {{dragging?'dragging':''}}" style="transform:translateX({{132+offset}}px);visibility:{{offset<0?'visible':'hidden'}}" aria-hidden="{{!actions}}"><button class="control swipe-action flag {{field.problem?'flag-active':''}}" aria-label="{{field.problem?'取消问题':'标记问题'}}" data-tray="true" catchtouchstart="start" data-action="flag" catchtap="trayAction" disabled="{{!actions}}"><image class="swipe-icon" src="/assets/icons/{{field.problem?'swipe-issue-active':'swipe-issue'}}.png" mode="aspectFit" aria-hidden="true"/></button><button class="control swipe-action note-action" aria-label="备注" data-tray="true" catchtouchstart="start" data-action="note" catchtap="trayAction" disabled="{{!actions}}"><image class="swipe-icon" src="/assets/icons/swipe-note.png" mode="aspectFit" aria-hidden="true"/></button><button class="control swipe-action media-action" aria-label="拍摄" data-tray="true" catchtouchstart="start" data-action="media" catchtap="trayAction" disabled="{{!actions}}"><image class="swipe-icon" src="/assets/icons/swipe-camera.png" mode="aspectFit" aria-hidden="true"/></button></view>
 <view class="head swipe-front" bindlongpress="reveal" aria-label="{{field.label}}，左滑或长按显示操作"><text class="label">{{field.label}}<text wx:if="{{field.heading&&field.expanded!==undefined}}" class="chevron muted">{{field.expanded?'⌃':'⌄'}}</text><text wx:if="{{field.multiple}}" class="muted"> · 多选</text></text></view>
 <view wx:if="{{field.wheel}}" class="wheel-entry"><button class="input wheel-trigger {{field.value===''?'wheel-empty':''}}" data-action="wheel" disabled="{{readonly}}" catchtap="action" aria-label="选择{{field.label}}">{{field.wheelDisplay}}<text class="wheel-chevron">⌄</text></button><button wx:if="{{commute}}" class="control commute-trigger" data-action="commute" aria-label="查询{{field.label}}" disabled="{{readonly}}" catchtap="action">查询</button></view>
 <view wx:elif="{{field.options.length||field.skippable||field.stats}}" class="answer-options {{field.inline && offset<0?'options-retracted':''}}" aria-hidden="{{field.inline && offset<0}}"><view class="choices {{dragging?'dragging':''}}" style="transform:translateX({{field.inline?offset/132*100:0}}%)"><view wx:if="{{field.stats}}" class="heading-stats muted"><view wx:if="{{field.heading==='category'}}" class="heading-progress" aria-hidden="true"><view class="heading-progress-fill {{field.stats.total>0&&field.stats.done===field.stats.total?'complete':''}}" style="width:{{field.stats.total?field.stats.done/field.stats.total*100:0}}%"/></view><text class="heading-count">{{field.stats.done}} / {{field.stats.total}}<text wx:if="{{field.stats.issues}}" class="issue-count"> · {{field.stats.issues}} 问题</text></text></view><button wx:if="{{field.skippable}}" class="control choice skip {{field.skipped?'selected':''}}" disabled="{{readonly}}" catchtap="skip">不涉及</button><button wx:for="{{field.options}}" wx:key="value" class="control choice {{item.selected?'selected':''}}" data-value="{{item.value}}" disabled="{{readonly}}" catchtap="choose">{{item.label||item.value}}</button></view></view>
 <picker wx:elif="{{field.type==='d'}}" mode="date" value="{{field.value}}" disabled="{{readonly}}" bindchange="input"><view class="input">{{field.value||'选择日期'}}</view></picker>
 <view wx:elif="{{speedTest}}" class="speed-entry"><input class="input" type="digit" value="{{field.value}}" placeholder="{{valueFocused||valueFilled?'':'网速'}}" data-input="value" bindfocus="handleInputFocus" bindblur="handleInputBlur" maxlength="2000" disabled="{{readonly}}" bindinput="input"/><text class="speed-unit">Mbps</text><button class="control speed-trigger" data-action="speed-test" disabled="{{readonly}}" catchtap="action">测试</button></view>
 <view wx:elif="{{commute}}" class="commute-entry"><input class="input" type="digit" aria-label="{{field.label}}" value="{{field.value}}" placeholder="{{valueFocused||valueFilled?'':'分钟'}}" data-input="value" bindfocus="handleInputFocus" bindblur="handleInputBlur" maxlength="2000" disabled="{{readonly}}" bindinput="input"/><button class="control commute-trigger" data-action="commute" aria-label="查询{{field.label}}" disabled="{{readonly}}" catchtap="action">查询</button></view>
 <input wx:elif="{{!field.heading&&!field.map}}" class="input" type="{{field.type==='n'?'digit':'text'}}" value="{{field.value}}" placeholder="{{valueFocused||valueFilled?'':field.type==='n'?'填写数值':'填写信息'}}" data-input="value" bindfocus="handleInputFocus" bindblur="handleInputBlur" maxlength="2000" disabled="{{readonly}}" bindinput="input"/>
 </view>
 <address-picker bindtouchstart="bodyStart" wx:if="{{field.map}}" address="{{address}}" location="{{location}}" anchor="{{anchor}}" readonly="{{readonly}}" bindselect="selectPlace"/>
 <input wx:if="{{field.other}}" class="input other" bindtouchstart="bodyStart" placeholder="{{otherFocused||otherFilled?'':'请填写其他内容'}}" data-input="other" bindfocus="handleInputFocus" bindblur="handleInputBlur" value="{{field.otherText}}" maxlength="2000" disabled="{{readonly}}" bindinput="other"/>
 <view wx:if="{{field.note}}" class="note" bindtouchstart="bodyStart" data-action="note" bindtap="action">{{field.note}}</view><view wx:if="{{field.photoRef}}" class="muted" bindtouchstart="bodyStart">原照片编号：{{field.photoRef}}</view>
 <view wx:if="{{field.media.length}}" class="thumbs" bindtouchstart="bodyStart"><view wx:for="{{field.thumbnails}}" wx:key="id" class="thumb" data-action="preview" bindtap="action"><image class="thumbnail" wx:if="{{item.type==='image'}}" src="{{item.path}}" mode="aspectFill"/><text wx:else>▶ 视频</text></view><view wx:if="{{field.media.length>3}}" class="thumb" data-action="preview" bindtap="action">+{{field.media.length-3}}</view></view>
</view>
