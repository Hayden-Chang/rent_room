.field{padding:12px 0;border-bottom:1px solid #e5e9f1;color:#1c2638}.bad{background:#fff0ef;color:#bb4149;padding:12px 8px;border-radius:8px}.head{display:flex;align-items:center;justify-content:space-between;min-height:32px;gap:8px;margin-bottom:6px}.label{font-size:13px;line-height:20px;flex:1}.muted{font-size:11px;color:#667187}.choices{display:flex;flex-wrap:wrap;gap:8px}.choice{font-size:13px;min-height:44px;line-height:20px;padding:12px 14px;background:#f5f7fb;color:#1c2638;border-radius:6px;margin:0}.selected{background:#eceeff;color:#4d56df}.input{width:100%;height:44px;border:1px solid #e5e9f1;border-radius:8px;padding:10px 12px;font-size:13px;background:#fff;box-sizing:border-box}.other{margin-top:8px}.note{font-size:12px;line-height:18px;color:#667187;margin-top:8px;white-space:pre-wrap;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.thumbs{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}.thumb{width:44px;height:44px;border-radius:6px;overflow:hidden;background:#eceeff;font-size:10px;line-height:44px}.thumbnail{width:100%;height:100%}.map-button{font-size:13px;background:#eceeff;color:#4d56df;margin:0;min-height:44px}.control::after{border:0}.readonly .control{opacity:.55}
.inline{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);column-gap:8px;align-items:center}.inline .head{margin-bottom:0}.inline .choice{flex:0 0 auto;min-width:44px;padding:12px 10px}.inline .choices{gap:4px;justify-content:flex-end}.inline .note,.inline .thumbs,.inline .other{grid-column:1 / -1}

.control{width:auto;min-width:0}.field.inline{padding-top:2px;padding-bottom:2px}.inline .head{min-height:44px}

.swipe-shell{position:relative;overflow:hidden;isolation:isolate}
.swipe-front{position:relative;z-index:1;background:#fff;transition:transform 180ms ease-out;will-change:transform}
.swipe-front.bad{background:#fff0ef}
.swipe-front.dragging{transition:none}
.swipe-tray{position:absolute;right:0;top:0;bottom:1px;width:180px;display:flex}
.swipe-action{width:60px;min-width:60px;min-height:44px;flex:0 0 60px;margin:0;padding:4px;font-size:12px;line-height:18px;border-radius:0;display:flex;align-items:center;justify-content:center;color:#4d56df;background:#eceeff;font-weight:500;box-sizing:border-box}
.swipe-action.flag{background:#fff0ef;color:#bb4149}
.swipe-action.note-action{background:#eceeff;color:#4d56df}
.swipe-action.media-action{background:#4d56df;color:#fff}
.swipe-shield{position:absolute;inset:0;z-index:2}

.swipe-icon{display:block;width:24px;height:24px}
.swipe-action.flag-active{background:#bb4149}

.choice{font-weight:400}
.field.hide-divider{border-bottom-color:transparent}

/* Give free text the remaining row width; short values need a compact control. */
.inline.text-field{grid-template-columns:auto minmax(0,1fr)}
.inline.text-field .head{max-width:104px}
.inline.number-field{grid-template-columns:minmax(0,1fr) 96px}
.inline.number-field .input{text-align:right}
