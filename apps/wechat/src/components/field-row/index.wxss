.field{position:relative;overflow:hidden;padding:12px 0;border-bottom:1px solid #e5e9f1;color:#1c2638}.bad{background:#fff0ef;color:#bb4149;padding:12px 8px;border-radius:8px}.head{display:flex;align-items:center;justify-content:space-between;min-height:44px;gap:8px;margin-bottom:0}.label{font-size:13px;line-height:20px;flex:1}.muted{font-size:11px;color:#667187}.choices{display:flex;flex-wrap:wrap;gap:8px}.choice{font-size:13px;min-height:44px;line-height:20px;padding:12px 14px;background:#f5f7fb;color:#1c2638;border-radius:6px;margin:0}.selected{background:#eceeff;color:#4d56df}.input{width:100%;height:44px;border:1px solid #e5e9f1;border-radius:8px;padding:10px 12px;font-size:13px;background:#fff;box-sizing:border-box}.other{margin-top:8px}.note{font-size:12px;line-height:18px;color:#667187;margin-top:8px;white-space:pre-wrap;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.thumbs{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}.thumb{width:44px;height:44px;border-radius:6px;overflow:hidden;background:#eceeff;font-size:10px;line-height:44px}.thumbnail{width:100%;height:100%}.map-button{font-size:13px;background:#eceeff;color:#4d56df;margin:0;min-height:44px}.control::after{border:0}.readonly .control{opacity:.55}
.inline .swipe-shell{display:grid;grid-template-columns:minmax(0,1fr) minmax(132px,auto);column-gap:8px;align-items:center}.inline .head{margin-bottom:0}.inline .choice{flex:0 0 auto;min-width:44px;padding:12px 10px}.inline .choices{gap:4px;justify-content:flex-end}

.control{width:auto;min-width:0}.field.inline{padding-top:2px;padding-bottom:2px}.inline .head{min-height:44px}

.swipe-shell{position:relative;overflow:hidden;min-width:0}
.inline .swipe-shell{margin-bottom:0}
/* One full-width hit region contains the title, answer and trailing actions. */
.swipe-front{padding-right:140px;box-sizing:border-box;margin-bottom:6px}
.inline .swipe-front{padding-right:0}
.swipe-tray{position:absolute;z-index:2;right:0;top:0;height:44px;width:132px;display:flex;transition:transform 180ms ease-out;will-change:transform}
.swipe-tray.dragging{transition:none}
.swipe-action{width:44px;min-width:44px;min-height:44px;flex:0 0 44px;margin:0;padding:4px;font-size:12px;line-height:18px;border-radius:0;display:flex;align-items:center;justify-content:center;color:#4d56df;background:#eceeff;font-weight:500;box-sizing:border-box}
.swipe-action.flag{background:#fff0ef;color:#bb4149}
.swipe-action.note-action{background:#eceeff;color:#4d56df}
.swipe-action.media-action{background:#4d56df;color:#fff}

.swipe-icon{display:block;width:24px;height:24px}
.swipe-action.flag-active{background:#bb4149}

.choice{font-weight:400}
.field.hide-divider{border-bottom-color:transparent}

/* Give free text the remaining row width; short values need a compact control. */
.inline.text-field .swipe-shell{grid-template-columns:minmax(0,auto) minmax(132px,1fr)}
.inline.text-field .head{max-width:104px}
.inline.number-field .input{width:96px;justify-self:end;text-align:right}

/* Clip only same-line choices; retain their layout and selected values. */
.inline .answer-options{overflow:hidden;min-width:0}
.inline .choices{transition:transform 180ms ease-out;will-change:transform}
.inline .choices.dragging{transition:none}
.inline .options-retracted{pointer-events:none}

.speed-trigger{flex-shrink:0;margin:0;min-height:44px;padding:10px 8px;font-size:13px;line-height:24px;background:#eceeff;color:#4d56df;border-radius:8px}

.speed-field.inline .swipe-shell{grid-template-columns:minmax(80px,1fr) minmax(0,1.8fr)}.speed-entry{display:flex;align-items:center;gap:6px;min-width:0}.speed-entry .input{min-width:0;flex:1;padding:10px 8px}.speed-unit{font-size:11px;color:#667187}
.commute-field.inline .swipe-shell{grid-template-columns:minmax(0,1fr) 136px}.commute-entry{display:flex;align-items:center;gap:8px;min-width:0}.commute-entry .input{width:76px;min-width:0;flex:1;padding:10px 8px}.commute-trigger{flex-shrink:0;margin:0;min-height:44px;padding:10px;font-size:13px;line-height:24px;background:#eceeff;color:#4d56df;border-radius:8px}

/* Categories and groups share the tested row gesture without becoming inputs. */
.heading{padding:4px 0;border-bottom:0}.heading .label{font-size:14px;font-weight:600}.heading .chevron{margin-left:8px;font-weight:400}.heading .swipe-shell{grid-template-columns:minmax(0,1fr) minmax(132px,auto)}.heading .head{min-height:48px}.heading.category .head{min-height:56px}.heading-stats{white-space:nowrap;font-size:12px;line-height:44px}.issue-count{color:#bb4149}.heading .choice{font-weight:600}.heading .skip{font-size:12px;font-weight:400}.heading .choices{flex-wrap:wrap}.heading.group{margin-top:8px;border-top:1px solid #e5e9f1}.heading.group .note,.heading.category .note{white-space:pre-wrap;-webkit-line-clamp:unset;display:block}

.wheel-entry{display:flex;align-items:center;justify-content:flex-end;gap:8px;min-width:0}.wheel-trigger{display:flex;align-items:center;justify-content:space-between;gap:8px;width:auto;min-width:96px;max-width:100%;margin:0;line-height:22px;text-align:right;color:#1c2638;font-weight:400}.wheel-trigger::after{border:0}.wheel-trigger.wheel-empty{color:#667187}.wheel-chevron{font-size:12px;color:#667187}.commute-field.inline.number-field .wheel-trigger{width:76px;min-width:0;flex:1;padding:10px 8px}
