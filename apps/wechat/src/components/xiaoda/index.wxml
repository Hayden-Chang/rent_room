<view class="xiaoda layout-{{layout}} {{closable?'closable':''}}"><image class="character" src="{{source}}" mode="aspectFit" aria-label="小搭"/><view class="bubble {{targetPointer?'pointing':''}}" catchtap="finish"><view class="reserve" aria-hidden="true"><block wx:for="{{fullParts}}" wx:key="key"><view wx:if="{{item.icon==='trash'}}" class="speech-trash" aria-label="红色垃圾桶"><view class="speech-trash-lid"/><view class="speech-trash-can"><view/><view/></view></view><image wx:elif="{{item.icon}}" class="speech-action speech-{{item.icon}}" src="/assets/icons/swipe-{{item.icon}}.png" mode="aspectFit" aria-label="{{item.icon==='issue'?'标记问题':item.icon==='note'?'写备注':'拍照或录视频'}}"/><text wx:else class="{{item.emphasis?'emphasis':''}}" style="{{item.emphasis&&highlightColor?'color:'+highlightColor:''}}">{{item.text}}</text></block></view><view class="spoken"><block wx:for="{{shownParts}}" wx:key="key"><view wx:if="{{item.icon==='trash'}}" class="speech-trash" aria-label="红色垃圾桶"><view class="speech-trash-lid"/><view class="speech-trash-can"><view/><view/></view></view><image wx:elif="{{item.icon}}" class="speech-action speech-{{item.icon}}" src="/assets/icons/swipe-{{item.icon}}.png" mode="aspectFit" aria-label="{{item.icon==='issue'?'标记问题':item.icon==='note'?'写备注':'拍照或录视频'}}"/><text wx:else class="{{item.emphasis?'emphasis':''}}" style="{{item.emphasis&&highlightColor?'color:'+highlightColor:''}}">{{item.text}}</text></block><text wx:if="{{!finished}}" class="cursor">▏</text></view><slot name="actions"/><view wx:if="{{targetPointer}}" class="target-tail" style="left:{{targetPointer}}" aria-hidden="true"/></view><button wx:if="{{closable}}" class="close" aria-label="关闭小搭" hover-class="none" catchtap="close"><view class="close-mark" aria-hidden="true"/></button></view>
