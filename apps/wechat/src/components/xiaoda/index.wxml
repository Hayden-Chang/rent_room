<view class="xiaoda layout-{{layout}} {{closable?'closable':''}}"><image class="character" src="{{source}}" mode="aspectFit" aria-label="小搭"/><view class="bubble" catchtap="finish"><text class="reserve" aria-hidden="true"><text wx:for="{{fullParts}}" wx:key="key" class="{{item.emphasis?'emphasis':''}}">{{item.text}}</text></text><text class="spoken"><text wx:for="{{shownParts}}" wx:key="key" class="{{item.emphasis?'emphasis':''}}">{{item.text}}</text><text wx:if="{{!finished}}" class="cursor">▏</text></text><slot name="actions"/><view wx:if="{{targetPointer}}" class="target-tail" style="left:{{targetPointer}}" aria-hidden="true"/></view><button wx:if="{{closable}}" class="close" aria-label="关闭小搭" hover-class="none" catchtap="close"><view class="close-mark" aria-hidden="true"/></button></view>
