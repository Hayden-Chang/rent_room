.xiaoda{display:flex;align-items:center;position:relative;min-height:108px;gap:14px}.character{width:88px;height:104px;flex-shrink:0}.bubble{position:relative;min-width:0;flex:1;background:#fff;border:2px solid #e2e5ec;border-radius:20px;padding:16px;font-size:16px;line-height:1.65;white-space:pre-wrap;color:#343b4d}.bubble::before{content:"";position:absolute;left:-9px;top:calc(50% - 8px);width:14px;height:14px;background:#fff;border-left:2px solid #e2e5ec;border-bottom:2px solid #e2e5ec;transform:rotate(45deg)}.reserve{visibility:hidden;display:block}.spoken{position:absolute;left:16px;right:16px;top:16px}.cursor{color:#5250dc}.emphasis{color:#b8860b;font-weight:700}.closable{padding-top:24px}.close:not([size=mini]){position:absolute;right:-10px;top:-12px;display:flex;align-items:center;justify-content:center;width:44px;height:44px;min-height:44px;margin:0;padding:0;border:0;border-radius:0;background:transparent;line-height:1}.close::after{border:0}.close-mark{position:relative;width:16px;height:16px}.close-mark::before,.close-mark::after{content:"";position:absolute;left:7px;top:0;width:2px;height:16px;border-radius:1px;background:#727c90;transform:rotate(45deg)}.close-mark::after{transform:rotate(-45deg)}.layout-compact,.layout-stage{gap:12px}.layout-compact .character,.layout-stage .character{width:72px;height:84px}.layout-compact .bubble,.layout-stage .bubble{padding:14px;font-size:15px}.layout-compact .spoken,.layout-stage .spoken{left:14px;right:14px;top:14px}.layout-hero{flex-direction:column-reverse;gap:20px}.layout-hero .character{width:144px;height:156px}.layout-hero .bubble{flex:none;width:100%;text-align:center;max-width:440px}.layout-hero .bubble::before{left:calc(50% - 8px);top:auto;bottom:-9px;transform:rotate(-45deg)}

.target-tail{position:absolute;bottom:-10px;width:18px;height:18px;box-sizing:border-box;background:#fff;border-right:2px solid #e2e5ec;border-bottom:2px solid #e2e5ec;transform:translateX(-50%) rotate(45deg);pointer-events:none}

.layout-compact .bubble.pointing{padding-bottom:18px}

/* One character of extra room for the three-stage introduction. */
.layout-stage{margin-left:-15px}

.speech-trash{position:relative;display:inline-block;width:20px;height:20px;vertical-align:-4px;color:#d94b55}.speech-trash-lid{position:absolute;top:4px;left:2px;right:2px;border-top:2px solid currentColor}.speech-trash-lid::before{content:"";position:absolute;top:-5px;left:4px;width:8px;height:5px;border:2px solid currentColor;border-bottom:0;border-radius:2px 2px 0 0;box-sizing:border-box}.speech-trash-can{position:absolute;top:4px;bottom:1px;left:4px;right:4px;border:2px solid currentColor;border-top:0;border-radius:0 0 3px 3px;display:flex;justify-content:center;gap:3px;padding-top:3px;box-sizing:border-box}.speech-trash-can view{width:2px;height:7px;border-radius:1px;background:currentColor}

.speech-action{display:inline-block;width:20px;height:20px;padding:2px;margin-left:2px;vertical-align:-5px}.speech-issue{background:#fff0ef}.speech-note{background:#eceeff}.speech-camera{background:#4d56df}
