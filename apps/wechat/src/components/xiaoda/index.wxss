.xiaoda{display:flex;align-items:center;position:relative;min-height:100px;gap:8px}.character{width:86px;height:96px;flex-shrink:0}.bubble{position:relative;flex:1;background:white;border:1px solid #e3e5f4;border-radius:18px;padding:16px;font-size:15px;line-height:1.65;white-space:pre-wrap;color:#29324b;box-shadow:0 4px 18px #222d4d08}.reserve{visibility:hidden;display:block}.spoken{position:absolute;left:16px;right:16px;top:16px}.cursor{color:#4d56df}.closable{padding-top:24px}.close:not([size=mini]){position:absolute;right:-10px;top:-12px;display:flex;align-items:center;justify-content:center;width:44px;height:44px;min-height:44px;margin:0;padding:0;border:0;border-radius:0;background:transparent;line-height:1}.close::after{border:0}.close-mark{position:relative;width:16px;height:16px}.close-mark::before,.close-mark::after{content:"";position:absolute;left:7px;top:0;width:2px;height:16px;border-radius:1px;background:#7b8499;transform:rotate(45deg)}.close-mark::after{transform:rotate(-45deg)}
.emphasis{color:#b8860b;font-weight:700}
