.xiaoda{display:flex;align-items:center;position:relative;min-height:108px;gap:14px}.character{width:88px;height:104px;flex-shrink:0}.bubble{position:relative;min-width:0;flex:1;background:#fff;border:2px solid #e2e5ec;border-radius:20px;padding:16px;font-size:16px;line-height:1.65;white-space:pre-wrap;color:#343b4d}.bubble::before{content:"";position:absolute;left:-9px;top:calc(50% - 8px);width:14px;height:14px;background:#fff;border-left:2px solid #e2e5ec;border-bottom:2px solid #e2e5ec;transform:rotate(45deg)}.reserve{visibility:hidden;display:block}.spoken{position:absolute;left:16px;right:16px;top:16px}.cursor{color:#5250dc}.emphasis{color:#b8860b;font-weight:700}.closable{padding-top:24px}.close:not([size=mini]){position:absolute;right:-10px;top:-12px;display:flex;align-items:center;justify-content:center;width:44px;height:44px;min-height:44px;margin:0;padding:0;border:0;border-radius:0;background:transparent;line-height:1}.close::after{border:0}.close-mark{position:relative;width:16px;height:16px}.close-mark::before,.close-mark::after{content:"";position:absolute;left:7px;top:0;width:2px;height:16px;border-radius:1px;background:#727c90;transform:rotate(45deg)}.close-mark::after{transform:rotate(-45deg)}.layout-compact{gap:12px}.layout-compact .character{width:72px;height:84px}.layout-compact .bubble{padding:14px;font-size:15px}.layout-compact .spoken{left:14px;right:14px;top:14px}.layout-hero{flex-direction:column-reverse;gap:20px}.layout-hero .character{width:144px;height:156px}.layout-hero .bubble{flex:none;width:100%;text-align:center;max-width:440px}.layout-hero .bubble::before{left:calc(50% - 8px);top:auto;bottom:-9px;transform:rotate(-45deg)}

.target-tail{position:absolute;bottom:-10px;width:18px;height:18px;box-sizing:border-box;background:#fff;border-right:2px solid #e2e5ec;border-bottom:2px solid #e2e5ec;transform:translateX(-50%) rotate(45deg);pointer-events:none}

.layout-compact .bubble.pointing{padding-bottom:18px}
