:host{display:block}.credits{color:#263047;font-size:14px}.summary{padding:20px;border:2px solid #e2e5ec;border-radius:20px;display:flex;align-items:center;justify-content:space-between;gap:12px}.summary-title{font-size:16px;font-weight:600}.balance{font-size:32px;font-weight:700;color:#5250dc;white-space:nowrap}.balance text{font-size:14px;font-weight:400;color:#667187}.migration{margin-top:16px;font-size:13px;line-height:1.5;color:#667187}.pack{margin-top:16px;padding:20px;border:2px solid #d9d6fb;border-radius:20px;background:#f8f7ff}.pack-title{font-size:17px;font-weight:700;line-height:1.6}.rules{margin-top:18px;color:#667187;line-height:1.5}.rules view+view{margin-top:10px}.actions{display:flex;align-items:center;gap:12px;margin-top:18px}button{font-size:15px;font-weight:600;line-height:1.5;padding:12px 8px;border:0;border-radius:12px}button::after{border:0}.cancel{background:transparent;color:#555bc1;min-width:72px;padding-left:0;padding-right:0}.purchase{flex:1;background:#4d56df;color:#fff;box-shadow:0 4px 0 #363eae}.purchase[disabled]{opacity:.45;background:#4d56df;color:#fff}.restore{margin-top:16px;width:100%;background:transparent;color:#555bc1;font-size:14px}.pending,.error{margin-top:16px;line-height:1.5}.pending{color:#4d56df}.error{color:#bb304a}
