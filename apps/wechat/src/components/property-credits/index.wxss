:host{display:block}
.credits{max-width:480px;margin:0 auto;color:#1c2638;font-size:15px}
.summary{padding:24px 0 16px;text-align:center}
.summary-title{font-size:15px;line-height:1.5;color:#667187}
.balance{margin-top:12px;font-size:64px;font-weight:700;line-height:1.2;color:#4d56df;overflow-wrap:anywhere}
.balance text{margin-left:8px;font-size:17px;font-weight:400;color:#667187}
.purchase-wrap{margin-top:24px;padding:0 20px}
.rules{margin-top:20px;color:#667187;line-height:1.5}
button{box-sizing:border-box;font-size:17px;font-weight:600;line-height:1.5;padding:14px 12px;border:0;border-radius:14px}
button::after{border:0}
.purchase{width:100%;min-height:52px;background:#4d56df;color:#fff}
.purchase-pressed{opacity:.8}
.purchase[disabled]{opacity:.45;background:#4d56df;color:#fff}
.restore{margin-top:24px;width:100%;min-height:44px;padding:12px;background:transparent;color:#667187;font-size:15px;font-weight:400}
.pending,.error{margin-top:24px;line-height:1.5}
.pending{color:#4d56df}.error{color:#bb4149}
