<view class="credits">
 <xiaoda wx:if="{{fromCreation && remaining === 0}}" id="credit-shortage-reminder" text="你的房源点数不够啦～" pose="think" layout="compact"/>
 <view class="summary"><view class="summary-title">剩余房源点数</view><view class="balance">{{remaining}}<text> 点</text></view><view class="rules">1 点 = 1 套新增房源</view></view>
 <view class="purchase-wrap">
  <button class="purchase" hover-class="purchase-pressed" loading="{{busy}}" disabled="{{busy}}" bindtap="purchase">{{pending?'核对付款并重试':authenticated?'¥1.99 购买 10 点':'微信登录后购买'}}</button>
 </view>
 <view wx:if="{{pending}}" class="pending">支付结果正在确认，点数到账前不会增加余额。</view>
 <view wx:if="{{error}}" class="error">{{error}}</view>
 <button class="restore" disabled="{{busy}}" bindtap="restore">{{authenticated?'刷新点数':'微信登录并恢复购买记录'}}</button>
</view>
