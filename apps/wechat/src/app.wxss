page{background:#f5f7fb;color:#1c2638;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:14px;line-height:1.5}view,text,input,textarea,button{box-sizing:border-box}button{margin:0;font-size:14px;line-height:1.5;font-weight:500;border-radius:8px;background:#fff;color:#1c2638;min-height:44px;padding:11px 14px}button::after{border:0}button[disabled]{opacity:.45}input{height:44px;min-width:0;background:#fff;border:1px solid #e5e9f1;border-radius:8px;padding:10px 12px}textarea{width:100%;min-height:140px;background:#f5f7fb;border-radius:8px;padding:12px}.page{padding:16px 16px 32px}.row{display:flex;align-items:center;gap:8px}.between{justify-content:space-between}.grow{flex:1;min-width:0}.muted{color:#667187;font-size:12px}.title{font-size:22px;font-weight:600;line-height:1.4}.subtitle{font-size:17px;font-weight:600}.primary{background:#4d56df;color:#fff}.soft,.selected{background:#eceeff;color:#4d56df}.danger{color:#bb4149;background:#fff0ef}.card{background:#fff;border-radius:16px;padding:16px;margin-bottom:12px}.empty{text-align:center;padding:56px 24px;color:#667187}.empty .subtitle{color:#1c2638;margin-bottom:12px}.chips{display:flex;flex-wrap:wrap;gap:8px}.chip{font-size:13px;padding:10px 14px;border-radius:22px}.section-title{font-weight:600;font-size:16px;margin:20px 0 12px}.space{height:16px}.error{padding:12px 16px;background:#fff0ef;color:#bb4149;border-radius:10px;margin-bottom:12px}.hint{font-size:12px;color:#667187;padding:10px 0}.line{height:1px;background:#e5e9f1;margin:12px 0}.menu{width:100%;text-align:left;display:flex;justify-content:space-between;align-items:center;padding:14px 0;border-bottom:1px solid #e5e9f1;border-radius:0}.badge{display:inline-block;padding:3px 8px;background:#eceeff;color:#4d56df;border-radius:6px;font-size:11px}.mask{position:fixed;inset:0;background:rgba(28,38,56,.38);z-index:90;display:flex;align-items:flex-end}.sheet{background:white;width:100%;padding:24px 20px calc(24px + env(safe-area-inset-bottom));border-radius:20px 20px 0 0;max-height:85vh;overflow:auto}.sheet .subtitle{margin-bottom:16px}.sheet .row{margin-top:16px}.sheet button{flex:1}.sheet input{margin:12px 0}.label{font-size:13px;color:#667187;margin:12px 0 6px}.money{font-size:18px;color:#4d56df;font-weight:600}.link{color:#4d56df;background:transparent}.readonly{background:#eceeff;color:#4d56df;padding:10px 16px;font-size:12px}.check{width:22px;height:22px;border:1px solid #e5e9f1;border-radius:6px;text-align:center;line-height:20px;color:#fff}.check.on{background:#4d56df;border-color:#4d56df}.break{word-break:break-all}

/* style-v2 supplies a width even when size is omitted. Match that case too. */
button:not([size=mini]){width:auto;min-width:0;margin:0}.menu:not([size=mini]){width:100%}

.auth-wait{padding:64px 24px;text-align:center;color:#667187}
