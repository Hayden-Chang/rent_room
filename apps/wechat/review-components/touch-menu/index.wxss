.touch-menu-layer{position:fixed;inset:0;z-index:1000;background:transparent;}
.touch-menu-panel{position:absolute;box-sizing:border-box;background:#fff;border-radius:14px;box-shadow:0 4px 12px rgba(0,0,0,.16);}
.touch-menu-items{padding:6px 0;}
.touch-menu-action{display:flex;align-items:center;width:100%;height:48px;min-height:48px;margin:0;padding:0 18px;border:0;border-radius:0;background:transparent;color:#263047;font-size:16px;font-weight:400;line-height:1.4;text-align:left;}
.touch-menu-action::after{border:0;}
.touch-menu-action.destructive{color:#e5484d;}
